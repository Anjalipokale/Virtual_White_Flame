<%- include("Navbar") %>

<style>

.callback-table{
    width: 90%;
    margin: 100px auto 40px auto;
    text-align: center;
    margin-bottom: 70px;
}

.callback-table h2{
    color: #003366;
    font-size: 32px;
    margin-bottom: 25px;
}

table{
    width: 90%;
    border-collapse: collapse;
    box-shadow: 0 0 15px #ccc;
    margin-left: 200px;
}

table th{
    background-color: #33933f;
    color: white;
    padding: 15px;
}

table td{
    background: #f9f9f9;
    padding: 12px;
}

table tr:hover td{
    background: #e6f2ff;
}

.delete-btn{
    background-color: #e53935;
    color: white;
    padding: 8px 15px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

.delete-btn:hover{
    background-color: #b71c1c;
}
.top-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
    flex-wrap:wrap;
}

.top-actions input{
    width:300px;
    padding:10px;
    border:1px solid #ccc;
    border-radius:8px;
}

.top-actions button{
    background:#33933f;
    color:#fff;
    border:none;
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.top-actions button:hover{
    background:#287a32;
}

#pagination button:hover{
    background:#287a32 !important;
    color:#fff;
}
</style>


<div class="callback-table">

<h2>Callback Requests</h2>
<div class="top-actions">

    <input
        type="text"
        id="searchInput"
        placeholder="Search Name..."
    >

    <button onclick="downloadCSV()">CSV</button>

    <button onclick="printTable()">Print</button>

</div>

<table border="1" id="callbackTable">

<tr>
    <th>ID</th>
    <th>Name</th>
    <th>Mobile</th>
    <th>Preferred Time</th>
    <th>Action</th>
</tr>

<% callback.forEach(function(item,index){ %>

<tr>

    <td><%= index + 1 %></td>

    <td><%= item.name %></td>

    <td><%= item.mobile %></td>

    <td><%= item.preferred_time %></td>
    
    <td>
        <a href="/admin/delete-callback/<%= item.id %>" class="delete-btn">
            Delete
        </a>
    </td>

</tr>

<% }) %>

</table>
<div id="pagination" style="text-align:center; margin-top:20px;"></div>

</div>

<script>

// Search

document.getElementById("searchInput").addEventListener("keyup", function(){

    let filter = this.value.toLowerCase();

    let rows = document.querySelectorAll("#callbackTable tr");

    rows.forEach((row,index)=>{

        if(index === 0) return;

        let name = row.cells[1].innerText.toLowerCase();

        if(name.includes(filter)){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

});


// CSV Download

function downloadCSV(){

    let csv = [];
    let rows = document.querySelectorAll("#callbackTable tr");

    rows.forEach((row)=>{

        let cols = row.querySelectorAll("td,th");

        let rowData = [];

        cols.forEach((col)=>{
            rowData.push('"' + col.innerText + '"');
        });

        csv.push(rowData.join(","));

    });

    let blob = new Blob([csv.join("\n")],{
        type:"text/csv"
    });

    let link = document.createElement("a");

    link.href = URL.createObjectURL(blob);

    link.download = "callback_requests.csv";

    link.click();

}


// Print

function printTable(){

    let table = document.getElementById("callbackTable").outerHTML;

    let win = window.open("", "", "width=1000,height=700");

    win.document.write(`
        <html>
        <head>
            <title>Callback Requests</title>
            <style>
                table{
                    width:100%;
                    border-collapse:collapse;
                }
                th,td{
                    border:1px solid #000;
                    padding:10px;
                    text-align:center;
                }
            </style>
        </head>
        <body>

            <h2>Callback Requests</h2>

            ${table}

        </body>
        </html>
    `);

    win.document.close();

    win.print();

}

// Pagination

const rowsPerPage = 10;

const rows = document.querySelectorAll("#callbackTable tr:not(:first-child)");

const pagination = document.getElementById("pagination");

let currentPage = 1;

function displayRows(page){

    rows.forEach((row,index)=>{

        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;

        if(index >= start && index < end){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

}

function setupPagination(){

    let pageCount = Math.ceil(rows.length / rowsPerPage);

    pagination.innerHTML = "";

    for(let i=1; i<=pageCount; i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        btn.style.margin = "0 5px";
        btn.style.padding = "8px 12px";
        btn.style.border = "none";
        btn.style.borderRadius = "5px";
        btn.style.cursor = "pointer";

        if(i === currentPage){
            btn.style.background = "#33933f";
            btn.style.color = "#fff";
        }
        else{
            btn.style.background = "#ddd";
        }

        btn.addEventListener("click", function(){

            currentPage = i;

            displayRows(currentPage);

            setupPagination();

        });

        pagination.appendChild(btn);

    }

}

displayRows(currentPage);
setupPagination();
</script>
<%- include("Footer") %>