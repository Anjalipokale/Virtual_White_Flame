<%- include('Navbar') %>

<div class="container-fluid px-4" style="margin-left:250px; width:calc(100% - 250px); margin-top:100px;">

    <!-- Form Card -->
    <div class="card shadow mb-4">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Add Slider Image</h4>
        </div>

        <div class="card-body">

            <form action="/admin/save_slider"
                  method="post"
                  enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Slider Image</label>
                    <input type="file"
                           name="image"
                           class="form-control"
                           required>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save
                </button>

            </form>

        </div>

    </div>

    <!-- Table Card -->
    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0">All Slider Images</h4>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped text-center align-middle">

                    <thead>
                        <tr>
                            <th>Sr No.</th>
                            <th>Image</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% slider.forEach(function(item,index){ %>

                        <tr>

                            <td><%= index + 1 %></td>

                            <td>
                                <img src="/uploads/<%= item.image %>"
                                     width="150"
                                     height="80"
                                     style="object-fit:cover;">
                            </td>

                            <td>
                                <a href="/admin/edit_slider/<%= item.id %>"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a href="/admin/delete_slider/<%= item.id %>"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Delete this image?')">
                                    Delete
                                </a>
                            </td>

                        </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>