

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%- include("navbar.ejs") %>
<title>Edit Product</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:#f4f6f9;
}



.form-container{
    max-width:100%;
    margin:40px auto;
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,.08);
    width: 60%;
    margin-top: 90px;
    margin-bottom:80px;
}

.title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    text-align:center;
}

.old-image{
    width:180px;
    height:180px;
    object-fit:cover;
    border-radius:12px;
    border:2px solid #ddd;
    margin-bottom:15px;
}

.btn-update{
    background:#198754;
    color:#fff;
    padding:12px 30px;
    border:none;
}

.btn-update:hover{
    background:orange;
    color:#fff;
}

</style>

</head>
<body>

<div class="container">

    <div class="form-container">

        <h2 class="title">
            Update Product
        </h2>

        <form
        action="/admin/update-product/<%= product.id %>"
        method="post"
        enctype="multipart/form-data">

            <div class="mb-3">

                <label class="form-label">
                    Product Name
                </label>

                <input
                type="text"
                name="product_name"
                class="form-control"
                value="<%= product.product_name %>"
                required>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Short Description
                </label>

                <textarea
                name="short_description"
                class="form-control"
                rows="3"><%= product.short_description %></textarea>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Full Description
                </label>

                <textarea
                name="description"
                class="form-control"
                rows="6"><%= product.description %></textarea>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label>Feature 1</label>

                    <input
                    type="text"
                    name="feature1"
                    class="form-control"
                    value="<%= product.feature1 %>">
                </div>

                <div class="col-md-6 mb-3">
                    <label>Feature 2</label>

                    <input
                    type="text"
                    name="feature2"
                    class="form-control"
                    value="<%= product.feature2 %>">
                </div>

                <div class="col-md-6 mb-3">
                    <label>Feature 3</label>

                    <input
                    type="text"
                    name="feature3"
                    class="form-control"
                    value="<%= product.feature3 %>">
                </div>

                <div class="col-md-6 mb-3">
                    <label>Feature 4</label>

                    <input
                    type="text"
                    name="feature4"
                    class="form-control"
                    value="<%= product.feature4 %>">
                </div>

            </div>

            <div class="mb-3 text-center">

                <h5>Current Image</h5>

                <img
                src="/uploads/<%= product.main_image %>"
                class="old-image">

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Change Image
                </label>

                <input
                type="file"
                name="main_image"
                class="form-control">

            </div>

            <div class="text-center">

                <button
                type="submit"
                class="btn btn-update">

                    Update Product

                </button>

                <a
                href="/admin/products"
                class="btn btn-secondary">

                    Back

                </a>

            </div>

        </form>

    </div>

</div>
<%- include("footer.ejs") %>
</body>
</html>
