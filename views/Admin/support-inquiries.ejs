<%- include("navbar.ejs") %>

<style>

body{
    background:#f4f8f4;
}

.requests-wrapper{
    width:75%;
    margin:100px auto;
    margin-left: 300px;
}

.requests-title{
    text-align:center;
    color:#2E7D32;
    font-size:34px;
    font-weight:700;
    margin-bottom:30px;
}

.table-container{
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(0,0,0,0.08);
}

.requests-table{
    width:100%;
    border-collapse:collapse;
}

.requests-table thead{
    background:linear-gradient(135deg,#2E7D32,#43A047);
}

.requests-table thead th{
    color:#fff;
    padding:18px;
    text-align:center;
    font-size:15px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.requests-table td{
    padding:15px;
    text-align:center;
    border-bottom:1px solid #eee;
}

.requests-table tbody tr:hover{
    background:#f8fff8;
}

.btn-accept{
    background:#2E7D32;
    color:#fff;
    text-decoration:none;
    padding:8px 15px;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    display:inline-block;
    margin-right:5px;
    transition:.3s;
}

.btn-accept:hover{
    background:#1B5E20;
    color:#fff;
}

.btn-delete{
    background:#FF8F00;
    color:#fff;
    text-decoration:none;
    padding:8px 15px;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    display:inline-block;
    transition:.3s;
}

.btn-delete:hover{
    background:#EF6C00;
    color:#fff;
}

.status-pending{
    color:#FF8F00;
    font-weight:700;
}

.status-accepted{
    color:#2E7D32;
    font-weight:700;
}

@media(max-width:992px){

    .requests-wrapper{
        width:95%;
    }

    .table-container{
        overflow-x:auto;
    }

    .requests-table{
        min-width:1000px;
    }

}
.top-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin-bottom:25px;
    flex-wrap:wrap;
}

.top-actions input{
    width:300px;
    padding:10px 15px;
    border:1px solid #ccc;
    border-radius:8px;
}

.top-actions button{
    background:#2E7D32;
    color:#fff;
    border:none;
    padding:10px 18px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.top-actions button:hover{
    background:#1B5E20;
}

#pagination button{
    margin:0 5px;
    padding:8px 12px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

#pagination button:hover{
    background:#1B5E20 !important;
    color:#fff;
}
</style>


<div class="requests-wrapper">

    <h2 class="requests-title">
        Support Inquiry Requests
    </h2>

    <div class="top-actions">

        <input
            type="text"
            id="searchInput"
            placeholder="Search by Name..."
        >

        <button onclick="downloadCSV()">CSV</button>

        <button onclick="printTable()">Print</button>

    </div>

    <div class="table-container">

    <table class="requests-table" id="requestsTable">

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Message</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

       <tbody>

<% requests.forEach((item,index)=>{ %>

<tr>

    <td><%= index + 1 %></td>

    <td><%= item.name %></td>

    <td><%= item.phone %></td>

    <td><%= item.email %></td>

    <td><%= item.message %></td>

    <td>

        <% if(item.status=="Accepted"){ %>

            <span class="status-accepted">
                Accepted
            </span>

        <% } else { %>

            <span class="status-pending">
                Pending
            </span>

        <% } %>

    </td>

    <td>

        <a href="/admin/accept-support/<%= item.id %>"
           class="btn-accept">
           Accept
        </a>

        <a href="/admin/delete-support/<%= item.id %>"
           class="btn-delete"
           onclick="return confirm('Are you sure you want to delete this inquiry?')">
           Delete
        </a>

    </td>

</tr>

<% }) %>

</tbody>

    </table>
    <div id="pagination" style="text-align:center; margin-top:20px;"></div>

</div>


</div>
<script>

// Search By Name

document.getElementById("searchInput").addEventListener("keyup", function() {

    let filter = this.value.toLowerCase();

    let rows = document.querySelectorAll("#requestsTable tbody tr");

    rows.forEach((row)=>{

        let name = row.cells[1].innerText.toLowerCase();

        if(name.includes(filter)){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

});


// CSV Download

function downloadCSV(){

    let csv = [];

    let rows = document.querySelectorAll("#requestsTable tr");

    rows.forEach((row)=>{

        let cols = row.querySelectorAll("td, th");

        let rowData = [];

        cols.forEach((col)=>{
            rowData.push('"' + col.innerText + '"');
        });

        csv.push(rowData.join(","));

    });

    let csvFile = new Blob([csv.join("\n")], {
        type:"text/csv"
    });

    let downloadLink = document.createElement("a");

    downloadLink.href = window.URL.createObjectURL(csvFile);

    downloadLink.download = "support_requests.csv";

    downloadLink.click();

}


// Print Table

function printTable(){

    let table = document.getElementById("requestsTable").outerHTML;

    let win = window.open("", "", "width=1000,height=700");

    win.document.write(`
        <html>
        <head>
            <title>Support Requests</title>
            <style>
                table{
                    width:100%;
                    border-collapse:collapse;
                }
                th,td{
                    border:1px solid #000;
                    padding:10px;
                    text-align:center;
                }
            </style>
        </head>
        <body>
            <h2>Support Inquiry Requests</h2>
            ${table}
        </body>
        </html>
    `);

    win.document.close();
    win.print();

}

// Pagination

const rowsPerPage = 10;

const rows = document.querySelectorAll(
    "#requestsTable tbody tr"
);

const pagination = document.getElementById("pagination");

let currentPage = 1;

function displayRows(page){

    rows.forEach((row,index)=>{

        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;

        if(index >= start && index < end){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

}

function setupPagination(){

    let pageCount = Math.ceil(
        rows.length / rowsPerPage
    );

    pagination.innerHTML = "";

    for(let i=1; i<=pageCount; i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        if(i === currentPage){
            btn.style.background = "#2E7D32";
            btn.style.color = "#fff";
        }
        else{
            btn.style.background = "#ddd";
        }

        btn.addEventListener("click", function(){

            currentPage = i;

            displayRows(currentPage);

            setupPagination();

        });

        pagination.appendChild(btn);

    }

}

displayRows(currentPage);

setupPagination();

</script>

<%- include("footer.ejs") %>