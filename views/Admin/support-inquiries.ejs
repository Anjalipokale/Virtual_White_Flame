<%- include("navbar.ejs") %>

<style>

body{
    background:#f4f8f4;
}

.requests-wrapper{
    width:75%;
    margin:100px auto;
    margin-left: 300px;
}

.requests-title{
    text-align:center;
    color:#2E7D32;
    font-size:34px;
    font-weight:700;
    margin-bottom:30px;
}

.table-container{
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(0,0,0,0.08);
}

.requests-table{
    width:100%;
    border-collapse:collapse;
}

.requests-table thead{
    background:linear-gradient(135deg,#2E7D32,#43A047);
}

.requests-table thead th{
    color:#fff;
    padding:18px;
    text-align:center;
    font-size:15px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.requests-table td{
    padding:15px;
    text-align:center;
    border-bottom:1px solid #eee;
}

.requests-table tbody tr:hover{
    background:#f8fff8;
}

.btn-accept{
    background:#2E7D32;
    color:#fff;
    text-decoration:none;
    padding:8px 15px;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    display:inline-block;
    margin-right:5px;
    transition:.3s;
}

.btn-accept:hover{
    background:#1B5E20;
    color:#fff;
}

.btn-delete{
    background:#FF8F00;
    color:#fff;
    text-decoration:none;
    padding:8px 15px;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    display:inline-block;
    transition:.3s;
}

.btn-delete:hover{
    background:#EF6C00;
    color:#fff;
}

.status-pending{
    color:#FF8F00;
    font-weight:700;
}

.status-accepted{
    color:#2E7D32;
    font-weight:700;
}

@media(max-width:992px){

    .requests-wrapper{
        width:95%;
    }

    .table-container{
        overflow-x:auto;
    }

    .requests-table{
        min-width:1000px;
    }

}

</style>

<div class="requests-wrapper">


<h2 class="requests-title">
    Support Inquiry Requests
</h2>

<div class="table-container">

    <table class="requests-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Message</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            <% requests.forEach((item)=>{ %>

            <tr>

                <td><%= item.id %></td>

                <td><%= item.name %></td>

                <td><%= item.phone %></td>

                <td><%= item.email %></td>

                <td><%= item.message %></td>

                <td>

                    <% if(item.status=="Accepted"){ %>

                        <span class="status-accepted">
                            Accepted
                        </span>

                    <% } else { %>

                        <span class="status-pending">
                            Pending
                        </span>

                    <% } %>

                </td>

                <td>

                    <a href="/admin/accept-support/<%= item.id %>"
                       class="btn-accept">
                       Accept
                    </a>

                    <a href="/admin/delete-support/<%= item.id %>"
                       class="btn-delete"
                       onclick="return confirm('Are you sure you want to delete this inquiry?')">
                       Delete
                    </a>

                </td>

            </tr>

            <% }) %>

        </tbody>

    </table>

</div>


</div>

<%- include("footer.ejs") %>
