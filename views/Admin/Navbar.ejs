    }

    .main-content{
        margin-left:64px;
    }

    .dropdown-menu-custom{
        min-width:160px;
    }

    .sidebar > ul > li > a{
        padding:8px 2px;
        font-size:7.5px;
    }

    .sidebar > ul > li > a i{
        font-size:15px;
    }

    .logo h4{
        font-size:9px;
    }

    .logo span{
        font-size:7px;
    }

    .admin-details{
        display:none;
    }
}

</style>
