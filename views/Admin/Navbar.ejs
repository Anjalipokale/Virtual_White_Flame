<script>
function toggleDropdown(event){
    event.preventDefault();

    let toggle = event.currentTarget;
    let menu = toggle.nextElementSibling;

    document.querySelectorAll('.dropdown-menu-custom').forEach(item => {
        if(item !== menu){
            item.classList.remove('show');
            item.style.position = '';
            item.style.top = '';
            item.style.left = '';
            item.style.maxHeight = '';
        }
    });

    let isOpening = !menu.classList.contains('show');
    menu.classList.toggle('show');

    if(isOpening && window.innerWidth <= 768){
        // Mobile: place the flyout with fixed positioning, calculated from the
        // toggle's real on-screen position, so it escapes the sidebar's
        // overflow:auto clipping instead of being hidden inside it.
        let rect = toggle.getBoundingClientRect();
        let left = rect.right + 6;
        let top = rect.top;

        menu.style.position = 'fixed';
        menu.style.left = left + 'px';
        menu.style.top = top + 'px';
        menu.style.maxHeight = (window.innerHeight - top - 10) + 'px';

        // Nudge back on screen if it would overflow the right/bottom edge
        requestAnimationFrame(function(){
            let menuRect = menu.getBoundingClientRect();
            if(menuRect.right > window.innerWidth){
                menu.style.left = Math.max(4, window.innerWidth - menuRect.width - 4) + 'px';
            }
            if(menuRect.bottom > window.innerHeight){
                menu.style.top = Math.max(4, window.innerHeight - menuRect.height - 4) + 'px';
            }
        });
    } else if(!isOpening || window.innerWidth > 768){
        menu.style.position = '';
        menu.style.top = '';
        menu.style.left = '';
        menu.style.maxHeight = '';
    }
}

window.addEventListener('resize', function(){
    if(window.innerWidth > 768){
        document.querySelectorAll('.dropdown-menu-custom').forEach(function(menu){
            menu.style.position = '';
            menu.style.top = '';
            menu.style.left = '';
            menu.style.maxHeight = '';
        });
    }
});
</script>

