<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Virtual White Flame Admin Panel</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

:root{
    --primary:#198754;
    --secondary:#2dbf7f;
    --light-green:#e8f8f0;
    --hover-green:#d7f3e5;
    --orange:#ff7a00;
    --white:#ffffff;
    --light:#f5faf7;
    --text:#1f2937;
}
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    background:var(--light);
}

/* ======================
   SIDEBAR
====================== */

.sidebar{
    position:fixed;
    top:0;
    left:0;
    width:260px;
    height:100vh;

    background:linear-gradient(
        180deg,
        #198754 0%,
        #2dbf7f 50%,
        #146c43 100%
    );

    overflow-y:auto;
    z-index:1000;
}

.logo{
    text-align:center;
    padding:25px 15px;
    color:#fff;
    background:rgba(255,255,255,0.1);
    border-bottom:1px solid rgba(255,255,255,0.2);
}

.logo h3{
    margin:0;
    font-weight:700;
}

.logo span{
    font-size:13px;
    opacity:.9;
}

.sidebar ul{
    list-style:none;
    padding:20px 0;
    margin:0;
}

.sidebar ul li{
    margin:8px 15px;
}

.sidebar ul li a{
    display:flex;
    align-items:center;
    gap:12px;

    text-decoration:none;
    color:#fff;

    padding:14px 18px;
    border-radius:12px;

    transition:.3s;
}

.sidebar ul li a{
    position:relative;
    overflow:hidden;
}


.sidebar ul li a::before{
    content:"";
    position:absolute;
    left:-100%;
    top:0;
    width:100%;
    height:100%;
    background:rgba(255,255,255,.15);
    transition:.4s;
}

.sidebar ul li a:hover::before{
    left:100%;
    background:rgba(255,255,255,0.15);
    color:#fff;
    transform:translateX(6px);
}

.sidebar ul li a.active,
.dropdown-toggle.active{
    background:#ff7a00;
    color:#fff !important;
    box-shadow:orange;
}

.sidebar ul li a:hover{
    background:rgba(255,122,0,.15);
    color:#fff;
}
.sidebar ul li a i{
    width:20px;
    text-align:center;
}

.sidebar::-webkit-scrollbar{
     width:5px;
}

.sidebar::-webkit-scrollbar-thumb{
   background:#8de2b8;
    border-radius:20px;
}
/* ======================
   NAVBAR
====================== */

.top-navbar{
    position:fixed;
    top:0;
    left:260px;
    right:0;

    height:70px;

    background:linear-gradient(
        90deg,
        #198754,
        #34c084,
        #198754
    );
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 30px;

    border-bottom:3px solid var(--orange);
    box-shadow:0 2px 10px rgba(0,0,0,.15);

    z-index:999;
}

.top-navbar h4{
    color:#fff;
    margin:0;
    font-weight:700;
}

.admin-info{
    display:flex;
    align-items:center;
    gap:10px;
    color:#fff;
}

.admin-info img{
    width:42px;
    height:42px;
    border-radius:50%;
    border:2px solid var(--orange);
}

/* ======================
   MAIN CONTENT
====================== */

.main-content{
    margin-left:260px;
    margin-top:90px;
    padding:30px;
    padding-bottom:100px;
}

.dashboard-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,.08);
}

.dashboard-card h2{
    color:var(--green);
}

/* ======================
   FOOTER
====================== */

.admin-footer{
    position:fixed;
    bottom:0;
    left:260px;
    right:0;

    height:60px;

    background:#fff;
    border-top:3px solid var(--orange);

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 25px;

    color:var(--green);
    font-weight:600;

    box-shadow:0 -2px 10px rgba(0,0,0,.08);
}

.footer-right{
    color:var(--orange);
}

/* ======================
   MOBILE
====================== */

@media(max-width:768px){

    .sidebar{
        width:70px;
    }

    .logo h3,
    .logo span{
        display:none;
    }

    .sidebar ul li a{
        justify-content:center;
        font-size:18px;
    }

    .sidebar ul li a span{
        display:none;
    }

    .top-navbar{
        left:70px;
    }

    .main-content{
        margin-left:70px;
    }

    .admin-footer{
        left:70px;
        flex-direction:column;
        justify-content:center;
        gap:2px;
        height:70px;
        text-align:center;
    }
}

.logo{
    text-align:center;
    padding:10px 10px;
    background:rgba(255,255,255,0.12);
    border-bottom:1px solid rgba(255,255,255,0.2);
}

.logo img{
    width:80px;
    height:80px;
    object-fit:cover;

    border-radius:50%;
    border:4px solid #fff;

    background:#fff;
    padding:3px;

    box-shadow:0 4px 15px rgba(0,0,0,0.2);
}

.logo h4{
    color:#fff;
    margin-top:12px;
    margin-bottom:2px;
    font-size:18px;
    font-weight:700;
}

.logo span{
    color:#e9ecef;
    font-size:13px;
    letter-spacing:1px;
}

.admin-info{
    display:flex;
    align-items:center;
    gap:12px;
    color:#fff;
}

.admin-info img{
    width:45px;
    height:45px;
    border-radius:50%;
    object-fit:cover;

    border:3px solid #ff6b00;
    background:#fff;

    box-shadow:0 2px 10px rgba(0,0,0,.2);
}

.admin-details h6{
    margin:0;
    font-size:15px;
    font-weight:600;
    color:#fff;
}

.admin-details small{
    color:#e9ecef;
    font-size:12px;
}

.dropdown-menu-custom{
    display: none;
    list-style: none;
    padding-left: 20px;
    margin-top: 5px;
}

.dropdown-menu-custom li{
    margin: 8px 0;
}

.dropdown-menu-custom li a{
    text-decoration: none;
    color: #fff;
    display: block;
    padding: 8px 10px;
    border-radius: 6px;
}

.dropdown-menu-custom li a:hover{
    background: rgba(255,255,255,0.1);
}

.dropdown-menu-custom{
    display:none;
    list-style:none;
    padding-left:20px;
    margin-top:5px;
}

.dropdown-menu-custom.show{
    display:block;
}

.dropdown-toggle.active{
    background:#ff7a00;
    color:#fff !important;
    border-radius:12px;
}

</style>
</head>

