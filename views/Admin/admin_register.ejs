<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Virtual White Flame - Admin Login</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    height:100vh;
    display:flex;
    overflow:hidden;
}

/* Left Side */

.left-panel{
    width:50%;
    background:linear-gradient(135deg,#198754,#0f5132);
    display:flex;
    justify-content:center;
    align-items:center;
    color:white;
    padding:50px;
}

.brand-content{
    text-align:center;
    max-width:500px;
}

.brand-logo{
    width:180px;
    margin-bottom:25px;
}

.brand-content h1{
    font-size:48px;
    margin-bottom:15px;
    font-weight:700;
}

.brand-content h2{
    color:#ffd699;
    font-size:22px;
    margin-bottom:20px;
    font-weight:500;
}

.brand-content p{
    font-size:16px;
    line-height:1.8;
    opacity:0.95;
}

/* Right Side */

.right-panel{
    width:50%;
    background:#f8f9fa;
    display:flex;
    justify-content:center;
    align-items:center;
}

.login-card{
    width:420px;
    background:white;
    padding:40px;
    border-radius:20px;
    box-shadow:0 0 30px rgba(0,0,0,0.1);
}

.login-card h2{
    text-align:center;
    color:#198754;
    margin-bottom:10px;
    font-size:32px;
}

.login-card p{
    text-align:center;
    color:#777;
    margin-bottom:30px;
}

.input-group{
    margin-bottom:20px;
}

.input-group label{
    display:block;
    margin-bottom:8px;
    font-weight:600;
    color:#444;
}

.input-group input{
    width:100%;
    padding:14px;
    border:1px solid #ddd;
    border-radius:8px;
    outline:none;
    font-size:15px;
}

.input-group input:focus{
    border-color:#198754;
}

.login-btn{
    width:100%;
    padding:14px;
    border:none;
    border-radius:8px;
    background:linear-gradient(135deg,#198754,#ff7a00);
    color:white;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    transition:0.3s;
}

.login-btn:hover{
    transform:translateY(-2px);
}

.footer-text{
    text-align:center;
    margin-top:20px;
    color:#888;
    font-size:13px;
}

/* Responsive */

@media(max-width:900px){

    body{
        flex-direction:column;
    }

    .left-panel,
    .right-panel{
        width:100%;
        height:50vh;
    }

    .login-card{
        width:90%;
    }
}

.alert-danger{
    background:#f8d7da;
    color:#842029;
    padding:12px;
    border-radius:8px;
    margin-bottom:15px;
    text-align:center;
    border:1px solid #f5c2c7;
}
</style>
</head>
<body>

<!-- Left Side -->

<div class="left-panel">

    <div class="brand-content">

        <!-- Replace with your logo -->
        <img src="/img/logo.jpg" alt="Logo" class="brand-logo">

        <h1>Virtual White Flame</h1>

        <h2>Admin Management Portal</h2>

        <p>
            Welcome to the Virtual White Flame Administration System.
            Manage website content, products, customer inquiries,
            dealer requests, careers, blogs and business operations
            through a secure dashboard.
        </p>

    </div>

</div>

<!-- Right Side -->

<div class="right-panel">

    <div class="login-card">

        <h2>Admin Login</h2>

        <p>
            Sign in with your authorized credentials
        </p>
           
        <% if(error){ %>

<div id="errorAlert" class="alert alert-danger text-center mb-3">
    <i class="fa-solid fa-circle-exclamation"></i>
    <%= error %>
</div>

<% } %>

        <form action="/admin/admin-login" method="POST">

            <div class="input-group">
                <label>Email Address</label>
                <input
                    type="email"
                    name="email"
                    placeholder="Enter Email"
                    required>
            </div>

            <div class="input-group">
                <label>Password</label>
                <input
                    type="password"
                    name="password"
                    placeholder="Enter Password"
                    required>
            </div>

            <button type="submit" class="login-btn">
                <i class="fa-solid fa-right-to-bracket"></i>
                Secure Login
            </button>
             
            <p style="text-align:center;margin-top:15px;">
            <a href="/admin/forgot-password">
    Forgot Password?
</a>
</p>
        </form>

        <div class="footer-text">
            © 2026 Virtual White Flame Pvt. Ltd.
        </div>

    </div>

</div>
<script>

setTimeout(function(){

    let alertBox = document.getElementById("errorAlert");

    if(alertBox){
        alertBox.style.display = "none";
    }

}, 3000);

</script>

</body>
</html>