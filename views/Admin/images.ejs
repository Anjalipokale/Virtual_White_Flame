<%- include("navbar.ejs") %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.gallery-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:50px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-label{
    font-weight:600;
}

.form-control,
.form-select{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus,
.form-select:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

.table-card{
    margin-top:30px;
}

.table th{
    background:#198754;
    color:#fff;
    text-align:center;
    padding:14px;
}

.table td{
    text-align:center;
    vertical-align:middle;
    padding:12px;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.gallery-img{
    width:80px;
    height:80px;
    object-fit:cover;
    border-radius:10px;
    border:2px solid #198754;
}

.edit-btn{
    background:#198754;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.edit-btn:hover{
    background:#146c43;
    color:#fff;
}

.delete-btn{
    background:#ff6b00;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

@media(max-width:992px){
    .gallery-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}
</style>

<div class="gallery-container">

    <!-- Add Gallery Image -->
    <div class="admin-card">

        <h2 class="section-title">
            Add Gallery Image
        </h2>

        <form action="/admin/save-image"
              method="post"
              enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label">
                    Image Title
                </label>

                <input type="text"
                       name="title"
                       class="form-control"
                       placeholder="Enter Image Title"
                       required>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Select Image
                </label>

                <input type="file"
                       name="image"
                       class="form-control"
                       required>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Category
                </label>

                <select name="category"
                        class="form-select">

                    <option value="">
                        Select Category
                    </option>

                    <option value="machinery">
                        Machinery
                    </option>

                    <option value="social">
                        Factory Photo
                    </option>

                    <option value="product">
                        Product
                    </option>

                </select>
            </div>

            <button type="submit"
                    class="save-btn">
                Add Image
            </button>

        </form>

    </div>

    <!-- Gallery List -->
    <div class="admin-card table-card">

        <h2 class="section-title">
            Gallery List
        </h2>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th width="220">Action</th>
                    </tr>
                </thead>

                <tbody>

                <% if(gallery && gallery.length > 0){ %>

                    <% gallery.forEach(function(item, i){ %>

                    <tr>

                        <td><%= i + 1 %></td>

                        <td>
                            <img src="<%= item.image %>"
                                 class="gallery-img">
                        </td>

                        <td><%= item.title %></td>

                        <td><%= item.category %></td>

                        <td>

                            <a href="/admin/edit-image/<%= item.id %>"
                               class="edit-btn">
                                Edit
                            </a>

                            <a href="/admin/delete-image/<%= item.id %>"
                               class="delete-btn"
                               onclick="return confirm('Delete this image?')">
                                Delete
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="5" class="text-center">
                            No Images Found
                        </td>
                    </tr>

                <% } %>

                </tbody>

            </table>
            <div id="pagination" style="text-align:center; margin-top:20px;"></div>
        </div>

    </div>

</div>
<script>

const rowsPerPage = 10;
const tableRows = document.querySelectorAll(".table tbody tr");

let currentPage = 1;

function showPage(page){

    currentPage = page;

    tableRows.forEach((row,index)=>{

        if(
            index >= (page - 1) * rowsPerPage &&
            index < page * rowsPerPage
        ){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

    createPagination();

}

function createPagination(){

    const pageCount = Math.ceil(
        tableRows.length / rowsPerPage
    );

    let pagination =
        document.getElementById("pagination");

    pagination.innerHTML = "";

    for(let i=1;i<=pageCount;i++){

        let btn =
            document.createElement("button");

        btn.innerText = i;

        btn.style.margin = "5px";
        btn.style.padding = "8px 15px";
        btn.style.border = "none";
        btn.style.borderRadius = "5px";
        btn.style.cursor = "pointer";

        if(i === currentPage){
            btn.style.background = "#198754";
            btn.style.color = "#fff";
        }else{
            btn.style.background = "#ddd";
        }

        btn.addEventListener(
            "click",
            function(){
                showPage(i);
            }
        );

        pagination.appendChild(btn);

    }

}

showPage(1);

</script>
<%- include("footer.ejs") %>