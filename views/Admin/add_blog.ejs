<%- include("Navbar") %>

<style>
body{
    background:#f5f7f8;
    font-family: Arial, sans-serif;
}

/* Main Content */
.blog-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

/* Cards */
.blog-card,
.table-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.blog-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

/* Form */
.form-group{
    margin-bottom:15px;
}

.form-control{
    width:100%;
    padding:12px;
    border:1px solid #ddd;
    border-radius:8px;
    font-size:15px;
}

.form-control:focus{
    outline:none;
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

textarea.form-control{
    height:150px;
    resize:none;
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

/* Table */
.table-card{
    margin-top:30px;
}

.table-title{
    color:#198754;
    font-weight:700;
    margin-bottom:20px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.table{
    width:100%;
    border-collapse:collapse;
}

.table th{
    background:#198754;
    color:white;
    padding:14px;
}

.table td{
    padding:14px;
    text-align:center;
    border-bottom:1px solid #eee;
    vertical-align:middle;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.blog-img{
    width:80px;
    height:80px;
    object-fit:cover;
    border-radius:10px;
    border:2px solid #198754;
}

.delete-btn{
    background:#ff6b00;
    color:white;
    padding:8px 15px;
    text-decoration:none;
    border-radius:6px;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:white;
}

.table-responsive{
    overflow-x:auto;
}

/* Mobile */
@media(max-width:992px){
    .blog-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}
</style>

<div class="blog-container">

    <!-- Add Blog Card -->
    <div class="blog-card">

        <h2 class="blog-title">
            Add Blog
        </h2>

        <form action="/admin/add-blog"
              method="POST"
              enctype="multipart/form-data">

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <input type="text"
                               name="title"
                               class="form-control"
                               placeholder="Enter Title"
                               required>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <input type="text"
                               name="category"
                               class="form-control"
                               placeholder="Enter Category"
                               required>
                    </div>
                </div>

            </div>

            <div class="form-group">
                <input type="file"
                       name="image"
                       class="form-control"
                       required>
            </div>

            <div class="form-group">
                <textarea name="content"
                          class="form-control"
                          placeholder="Enter Blog Content"
                          required></textarea>
            </div>

            <button type="submit" class="save-btn">
                Add Blog
            </button>

        </form>

    </div>

    <!-- Blog List -->
    <div class="table-card">

        <h3 class="table-title">
            All Blogs
        </h3>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% blogs.forEach(function(blog){ %>

                    <tr>

                        <td><%= blog.id %></td>

                        <td>
                            <img src="<%= blog.image %>"
                                 class="blog-img">
                        </td>

                        <td><%= blog.title %></td>

                        <td><%= blog.category %></td>

                        <td>
                            <a href="/admin/delete-blog/<%= blog.id %>"
                               class="delete-btn"
                               onclick="return confirm('Delete this blog?')">
                                Delete
                            </a>
                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<%- include("Footer") %>