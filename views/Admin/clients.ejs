<%- include("navbar.ejs") %>

<style>

body{
    background:#f5f7fb;
}

.main-wrapper{
    margin-left:260px;
    margin-top:90px;
    padding:25px;
    min-height:100vh;
}

/* Header */

.page-header{
    background:rgb(9, 102, 9);
    color:#fff;
    padding:25px 30px;
    border-radius:20px;
    margin-bottom:25px;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
}

.page-header h2{
    margin:0;
    font-weight:700;
}

/* Card */

.client-card{
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

/* Table */

.table{
    margin-bottom:0;
}

.table thead{
    background:#198754;
    color:#fff;
}

.table th{
    text-align:center;
    padding:15px;
    border:none;
    background-color:rgb(41, 140, 41);
}

.table td{
    text-align:center;
    vertical-align:middle;
    padding:15px;
}

.table tbody tr:hover{
    background:#fff8f0;
}

/* Badge */

.client-badge{
    background:#fff3e8;
    color:#ff7a00;
    padding:6px 12px;
    border-radius:30px;
    font-size:13px;
    font-weight:600;
}

/* Count Box */

.count-box{
    width:220px;
    background:#fff;
    border-left:5px solid #ff7a00;
    border-radius:15px;
    padding:20px;
    margin-bottom:25px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.count-box h3{
    color:#198754;
    font-size:32px;
    font-weight:700;
    margin:0;
}

.count-box p{
    margin:0;
    color:#666;
}

</style>

<div class="main-wrapper">

    <div class="page-header">

        <h2>
            <i class="fas fa-users me-2"></i>
            Registered Clients
        </h2>

    </div>

    <div class="count-box">

        <h3>
            <%= clients.length %>
        </h3>

        <p>
            Total Registered Clients
        </p>

    </div>

    <div class="client-card">

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>
                        <th>Sr No</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Register Date</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

    <% clients.forEach(function(c, index){ %>

    <tr>

        <td>
            <%= index + 1 %>
        </td>

        <td>
            <%= c.username %>
        </td>

        <td>
            <%= c.email %>
        </td>

        <td>
            <%= new Date(c.created_at).toLocaleDateString('en-IN') %>
        </td>

        <td>
    <a href="/admin/delete-client/<%= c.id %>"
       class="btn btn-danger btn-sm"
       onclick="return confirm('Are you sure you want to delete this client?')">
        <i class="fas fa-trash"></i> Delete
    </a>
</td>

    </tr>

    <% }) %>

</tbody>

            </table>

        </div>

    </div>

</div>

<%- include("footer.ejs") %>