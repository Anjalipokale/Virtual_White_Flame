<%- include('Navbar') %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.plant-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-control{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

.table-card{
    margin-top:30px;
}

.table{
    width:100%;
}

.table th{
    background:#198754;
    color:#fff;
    padding:14px;
    text-align:center;
}

.table td{
    padding:14px;
    text-align:center;
    vertical-align:middle;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.logo-img{
    width:70px;
    height:70px;
    object-fit:contain;
    border:2px solid #198754;
    border-radius:10px;
    padding:5px;
}

.edit-btn{
    background:#198754;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.edit-btn:hover{
    background:#146c43;
    color:#fff;
}

.delete-btn{
    background:#ff6b00;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

@media(max-width:992px){
    .plant-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}
</style>

<div class="plant-container">

    <!-- Add Plant Form -->
    <div class="admin-card">

        <h2 class="section-title">
            Add Manufacturing Plant
        </h2>

        <form action="/admin/save_manufacturing_plant"
              method="post"
              enctype="multipart/form-data">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Plant Logo</label>
                    <input type="file"
                           name="plant_logo"
                           class="form-control">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Plant Name</label>
                    <input type="text"
                           name="plant_name"
                           class="form-control">
                </div>

            </div>

            <div class="mb-3">
                <label class="fw-bold">Address</label>
                <textarea name="plant_address"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Phone</label>
                    <input type="text"
                           name="plant_phone"
                           class="form-control">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Email</label>
                    <input type="email"
                           name="plant_email"
                           class="form-control">
                </div>

            </div>

            <button type="submit" class="save-btn">
                Save Plant
            </button>

        </form>

    </div>

    <!-- Plants Table -->
    <div class="admin-card table-card">

        <h2 class="section-title">
            All Manufacturing Plants
        </h2>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Logo</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th width="200">Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% plants.forEach(function(p){ %>

                    <tr>

                        <td><%= p.id %></td>

                        <td>
                            <img src="/uploads/<%= p.plant_logo %>"
                                 class="logo-img">
                        </td>

                        <td><%= p.plant_name %></td>

                        <td><%= p.plant_phone %></td>

                        <td>

                            <a href="/admin/edit_manufacturing_plant/<%= p.id %>"
                               class="edit-btn">
                                Edit
                            </a>

                            <a href="/admin/delete_manufacturing_plant/<%= p.id %>"
                               class="delete-btn"
                               onclick="return confirm('Are you sure you want to delete this plant?')">
                                Delete
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<%- include('Footer') %>