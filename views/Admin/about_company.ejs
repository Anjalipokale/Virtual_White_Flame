<%- include('Navbar') %>

    <style>

    </style>
    <div class="main-content">

        <div class="container-fluid">

            <div class="card shadow border-0">

                <div class="card-header text-white" style="background:linear-gradient(90deg,#198754,#146c43);">
                    <h4 class="mb-0">
                        <i class="fas fa-building me-2"></i>
                        About Company
                    </h4>
                </div>

                <div class="card-body">

                    <form action="/admin/save_about_company" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="<%= about_company[0].id %>">

                        <input type="hidden" name="old_company_image" value="<%= about_company[0].company_image %>">
                       
                        <!-- Company Information -->

                        <h5 class="text-success mb-3">Company Information</h5>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Company Name</label>
                                <input type="text" name="company_name" class="form-control"
                                    value="<%=about_company[0].company_name%>">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tag Line</label>
                                <input type="text" name="tag_line" class="form-control"
                                    value="<%=about_company[0].tag_line%>">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Experience Years</label>
                                <input type="number" name="experience_years" class="form-control"
                                    value="<%=about_company[0].experience_years%>">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Company Image</label>
                                <input type="file" name="company_image" class="form-control">

                                <img src="/uploads/<%= about_company[0].company_image %>" width="150"
                                    class="img-thumbnail mt-2">

                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Company Description</label>
                                <textarea name="company_description" rows="5"
                                    class="form-control"><%=about_company[0].company_description%></textarea>
                            </div>

                        </div>

                        <hr class="my-4">

                        <!-- Features -->

                        <h5 class="text-success mb-4">Company Features</h5>

                        <div class="row g-4">

                            <div class="col-lg-6">
                                <div class="border rounded p-3 h-100">
                                    <label class="form-label fw-bold">Feature 1 Title</label>
                                    <input type="text" name="feature1_title" class="form-control mb-3"
                                        value="<%=about_company[0].feature1_title%>">

                                    <label class="form-label fw-bold">Feature 1 Description</label>
                                    <textarea name="feature1_desc" rows="3"
                                        class="form-control"><%=about_company[0].feature1_desc%></textarea>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="border rounded p-3 h-100">
                                    <label class="form-label fw-bold">Feature 2 Title</label>
                                    <input type="text" name="feature2_title" class="form-control mb-3"
                                        value="<%=about_company[0].feature2_title%>">

                                    <label class="form-label fw-bold">Feature 2 Description</label>
                                    <textarea name="feature2_desc" rows="3"
                                        class="form-control"><%=about_company[0].feature2_desc%></textarea>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="border rounded p-3 h-100">
                                    <label class="form-label fw-bold">Feature 3 Title</label>
                                    <input type="text" name="feature3_title" class="form-control mb-3"
                                        value="<%=about_company[0].feature3_title%>">

                                    <label class="form-label fw-bold">Feature 3 Description</label>
                                    <textarea name="feature3_desc" rows="3"
                                        class="form-control"><%=about_company[0].feature3_desc%></textarea>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="border rounded p-3 h-100">
                                    <label class="form-label fw-bold">Feature 4 Title</label>
                                    <input type="text" name="feature4_title" class="form-control mb-3"
                                        value="<%=about_company[0].feature4_title%>">

                                    <label class="form-label fw-bold">Feature 4 Description</label>
                                    <textarea name="feature4_desc" rows="3"
                                        class="form-control"><%=about_company[0].feature4_desc%></textarea>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="border rounded p-3 h-100">
                                    <label class="form-label fw-bold">Feature 5 Title</label>
                                    <input type="text" name="feature5_title" class="form-control mb-3"
                                        value="<%=about_company[0].feature5_title%>">

                                    <label class="form-label fw-bold">Feature 5 Description</label>
                                    <textarea name="feature5_desc" rows="3"
                                        class="form-control"><%=about_company[0].feature5_desc%></textarea>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="border rounded p-3 h-100">
                                    <label class="form-label fw-bold">Feature 6 Title</label>
                                    <input type="text" name="feature6_title" class="form-control mb-3"
                                        value="<%=about_company[0].feature6_title%>">

                                    <label class="form-label fw-bold">Feature 6 Description</label>
                                    <textarea name="feature6_desc" rows="3"
                                        class="form-control"><%=about_company[0].feature6_desc%></textarea>
                                </div>
                            </div>

                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-warning text-white px-5">
                                Save About Company
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

<%- include('Footer') %>

    <!-- 
CREATE TABLE about_company (
    id INT AUTO_INCREMENT PRIMARY KEY,

    company_name VARCHAR(255),
    tag_line VARCHAR(255),
    experience_years INT,
    company_image VARCHAR(255),

    company_description TEXT,

    feature1_title VARCHAR(255),
    feature1_desc TEXT,

    feature2_title VARCHAR(255),
    feature2_desc TEXT,

    feature3_title VARCHAR(255),
    feature3_desc TEXT,

    feature4_title VARCHAR(255),
    feature4_desc TEXT,

    feature5_title VARCHAR(255),
    feature5_desc TEXT,

    feature6_title VARCHAR(255),
    feature6_desc TEXT,

   
); -->