<%- include("navbar.ejs") %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.raw-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-label{
    font-weight:600;
}

.form-control{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

.table-card{
    margin-top:30px;
}

.table th{
    background:#198754;
    color:#fff;
    text-align:center;
    padding:14px;
}

.table td{
    text-align:center;
    vertical-align:middle;
    padding:12px;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.material-img{
    width:70px;
    height:70px;
    object-fit:cover;
    border-radius:10px;
    border:2px solid #198754;
}

.edit-btn{
    background:#198754;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.edit-btn:hover{
    background:#146c43;
    color:#fff;
}

.delete-btn{
    background:#ff6b00;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

@media(max-width:992px){
    .raw-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}

#pagination button{
    margin:0 5px;
    padding:8px 12px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

#pagination button:hover{
    background:#146c43 !important;
    color:#fff;
}
</style>

<div class="raw-container">

    <!-- Add Raw Material -->
    <div class="admin-card">

        <h2 class="section-title">
            Add Raw Material
        </h2>

        <form action="/admin/save-raw-material"
              method="POST"
              enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label">
                    Material Name
                </label>

                <input type="text"
                       name="name"
                       class="form-control"
                       placeholder="Enter Material Name"
                       required>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Material Image
                </label>

                <input type="file"
                       name="image"
                       class="form-control"
                       required>
            </div>

            <button type="submit"
                    class="save-btn">
                Save Material
            </button>

        </form>

    </div>

    <!-- Raw Material List -->
    <div class="admin-card table-card">

        <h2 class="section-title">
            Raw Material List
        </h2>

        <div class="table-responsive">

<table class="table" id="rawMaterialTable">
                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Image</th>
                        <th>Material Name</th>
                        <th width="220">Action</th>
                    </tr>
                </thead>

                <tbody>

                <% if(rawmaterials && rawmaterials.length > 0){ %>

                    <% rawmaterials.forEach(function(item,index){ %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td>
                            <img src="/uploads/<%= item.image %>"
                                 class="material-img">
                        </td>

                        <td>
                            <%= item.name %>
                        </td>

                        <td>

                            <a href="/admin/edit-raw-material/<%= item.id %>"
                               class="edit-btn">
                                Edit
                            </a>

                            <a href="/admin/delete-raw-material/<%= item.id %>"
                               class="delete-btn"
                               onclick="return confirm('Are you sure?')">
                                Delete
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="4" class="text-center">
                            No Raw Materials Found
                        </td>
                    </tr>

                <% } %>

                </tbody>

            </table>
         <div id="pagination" style="text-align:center; margin-top:20px;"></div>
        </div>

    </div>

</div>

<script>

// Pagination

const rowsPerPage = 10;

const rows = document.querySelectorAll(
    "#rawMaterialTable tbody tr"
);

const pagination = document.getElementById("pagination");

let currentPage = 1;

function displayRows(page){

    rows.forEach((row,index)=>{

        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;

        if(index >= start && index < end){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

}

function setupPagination(){

    let pageCount = Math.ceil(
        rows.length / rowsPerPage
    );

    pagination.innerHTML = "";

    for(let i=1; i<=pageCount; i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        if(i === currentPage){
            btn.style.background = "#198754";
            btn.style.color = "#fff";
        }else{
            btn.style.background = "#ddd";
        }

        btn.addEventListener("click", function(){

            currentPage = i;

            displayRows(currentPage);

            setupPagination();

        });

        pagination.appendChild(btn);

    }

}

displayRows(currentPage);
setupPagination();

</script>

<%- include("footer.ejs") %>