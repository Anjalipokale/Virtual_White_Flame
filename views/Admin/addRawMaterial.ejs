<%- include("navbar.ejs") %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.raw-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-label{
    font-weight:600;
}

.form-control{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

.table-card{
    margin-top:30px;
}

.table th{
    background:#198754;
    color:#fff;
    text-align:center;
    padding:14px;
}

.table td{
    text-align:center;
    vertical-align:middle;
    padding:12px;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.material-img{
    width:70px;
    height:70px;
    object-fit:cover;
    border-radius:10px;
    border:2px solid #198754;
}

.edit-btn{
    background:#198754;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.edit-btn:hover{
    background:#146c43;
    color:#fff;
}

.delete-btn{
    background:#ff6b00;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

@media(max-width:992px){
    .raw-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}
</style>

<div class="raw-container">

    <!-- Add Raw Material -->
    <div class="admin-card">

        <h2 class="section-title">
            Add Raw Material
        </h2>

        <form action="/admin/save-raw-material"
              method="POST"
              enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label">
                    Material Name
                </label>

                <input type="text"
                       name="name"
                       class="form-control"
                       placeholder="Enter Material Name"
                       required>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Material Image
                </label>

                <input type="file"
                       name="image"
                       class="form-control"
                       required>
            </div>

            <button type="submit"
                    class="save-btn">
                Save Material
            </button>

        </form>

    </div>

    <!-- Raw Material List -->
    <div class="admin-card table-card">

        <h2 class="section-title">
            Raw Material List
        </h2>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Material Name</th>
                        <th width="220">Action</th>
                    </tr>
                </thead>

                <tbody>

                <% if(rawmaterials && rawmaterials.length > 0){ %>

                    <% rawmaterials.forEach(function(item){ %>

                    <tr>

                        <td><%= item.id %></td>

                        <td>
                            <img src="/uploads/<%= item.image %>"
                                 class="material-img">
                        </td>

                        <td>
                            <%= item.name %>
                        </td>

                        <td>

                            <a href="/admin/edit-raw-material/<%= item.id %>"
                               class="edit-btn">
                                Edit
                            </a>

                            <a href="/admin/delete-raw-material/<%= item.id %>"
                               class="delete-btn"
                               onclick="return confirm('Are you sure?')">
                                Delete
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="4" class="text-center">
                            No Raw Materials Found
                        </td>
                    </tr>

                <% } %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<%- include("footer.ejs") %>