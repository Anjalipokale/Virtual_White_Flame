<%- include("navbar.ejs") %>

<style>

body{
    background:#f5f7f8;
    font-family:Arial, sans-serif;
}

/* Main Content */
.video-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

/* Cards */
.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

/* Form */
.form-label{
    font-weight:600;
}

.form-control,
.form-select{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus,
.form-select:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

/* Table */
.table-card{
    margin-top:30px;
}

.table th{
    background:#198754;
    color:#fff;
    text-align:center;
    padding:14px;
}

.table td{
    text-align:center;
    vertical-align:middle;
    padding:12px;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.video-preview{
    width:180px;
    height:100px;
    border-radius:10px;
}

/* Buttons */
.edit-btn{
    background:#198754;
    color:#fff;
    padding:8px 15px;
    text-decoration:none;
    border-radius:6px;
    font-weight:600;
    margin-right:5px;
}

.edit-btn:hover{
    background:#146c43;
    color:#fff;
}

.delete-btn{
    background:#ff6b00;
    color:#fff;
    padding:8px 15px;
    text-decoration:none;
    border-radius:6px;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

/* Mobile */
@media(max-width:992px){

    .video-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }

}

</style>

<div class="video-container">

    <!-- Add Video -->
    <div class="admin-card">

        <h2 class="section-title">
            Add Video
        </h2>

        <form action="/admin/save-video"
              method="post"
              enctype="multipart/form-data">

            <div class="mb-3">

                <label class="form-label">
                    Upload Video
                </label>

                <input type="file"
                       name="video"
                       class="form-control"
                       required>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Select Category
                </label>

                <select name="category"
                        class="form-select"
                        required>

                    <option value="">
                        Select Category
                    </option>

                    <option value="plant">
                        Plant Video
                    </option>

                    <option value="company">
                        Company Video
                    </option>

                </select>

            </div>

            <button type="submit"
                    class="save-btn">
                Upload Video
            </button>

        </form>

    </div>

    <!-- Video List -->
    <div class="admin-card table-card">

        <h2 class="section-title">
            Video List
        </h2>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Video</th>
                        <th>Category</th>
                        <th width="220">Action</th>
                    </tr>
                </thead>

                <tbody>

                <% if(videos.length > 0){ %>

                    <% videos.forEach(function(item, index){ %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td>

                            <video controls class="video-preview">
                                <source src="<%= item.video %>" type="video/mp4">
                            </video>

                        </td>

                        <td>
                            <%= item.category %>
                        </td>

                        <td>

                            <a href="/admin/edit-video/<%= item.id %>"
                               class="edit-btn">
                                Edit
                            </a>

                            <a href="/admin/delete-video/<%= item.id %>"
                               class="delete-btn"
                               onclick="return confirm('Delete this video?')">
                                Delete
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="4">
                            No Video Found
                        </td>
                    </tr>

                <% } %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<%- include("footer.ejs") %>