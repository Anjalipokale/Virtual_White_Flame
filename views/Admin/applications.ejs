<%- include("navbar.ejs") %>

<style>

body{
    background:#f4f6f9;
    font-family:Arial,sans-serif;
}

/* Main Container */

.table-box{
    width:78%;
    margin-top:80px;
    margin-bottom:80px;
    margin-left:280px;
    margin-right:0;
    background:#fff;
    padding:15px;
    border-radius:12px;
    box-shadow:0 4px 15px rgba(0,0,0,0.1);
    overflow-x:auto;
}

.table-box h2{
    text-align:center;
    color:#2E7D32;
    margin-bottom:20px;
}

/* Table */

table{
    width:100%;
    border-collapse:collapse;
    text-align:center;
    font-size:13px;
}

th{
    background:#2E7D32;
    color:#fff;
    padding:10px 6px;
    font-size:13px;
    white-space:nowrap;
}

td{
    padding:8px 6px;
    border-bottom:1px solid #e0e0e0;
    vertical-align:middle;
    font-size:12px;
}

tr:hover{
    background:#f9f9f9;
}

/* Status */

.status-text{
    color:#2E7D32;
    font-weight:bold;
}

/* Resume Button */

.view-btn{
    background:#2196F3;
    color:#fff;
    text-decoration:none;
    padding:6px 10px;
    border-radius:5px;
    font-size:11px;
    display:inline-block;
}

.view-btn:hover{
    background:#1565C0;
}

/* Action Buttons */

.action-box{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:4px;
}

.status-btn,
.delete-btn{
    text-decoration:none;
    color:#fff;
    min-width:80px;
    padding:6px 8px;
    border-radius:5px;
    font-size:10px;
    font-weight:600;
    text-align:center;
    transition:.3s;
}

.review-btn{
    background:#ff9800;
}

.review-btn:hover{
    background:#f57c00;
}

.shortlist-btn{
    background:#2196f3;
}

.shortlist-btn:hover{
    background:#1976d2;
}

.interview-btn{
    background:#9c27b0;
}

.interview-btn:hover{
    background:#7b1fa2;
}

.selected-btn{
    background:#2e7d32;
}

.selected-btn:hover{
    background:#1b5e20;
}

.delete-btn{
    background:#e53935;
}

.delete-btn:hover{
    background:#c62828;
}

/* Mobile */

@media(max-width:768px){

    .table-box{
        width:95%;
        margin:20px auto;
    }

    table{
        font-size:11px;
    }

    th,
    td{
        padding:6px 4px;
    }

}
.top-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
    flex-wrap:wrap;
}

.top-actions input{
    width:300px;
    padding:10px;
    border:1px solid #ccc;
    border-radius:8px;
}

.top-actions button{
    background:#2E7D32;
    color:#fff;
    border:none;
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.top-actions button:hover{
    background:#1B5E20;
}

</style>

<div class="table-box">


<h2>Job Applications</h2>
<div class="top-actions">

    <input
        type="text"
        id="searchInput"
        placeholder="Search Candidate Name..."
    >

    <button onclick="downloadCSV()">CSV</button>

    <button onclick="printTable()">Print</button>
    <a href="/admin/deleted-applications"
   style="
   background:#e53935;
   color:white;
   padding:10px 15px;
   border-radius:8px;
   text-decoration:none;
   font-weight:600;">
   Deleted Records
</a>

</div>

<table id="applicationTable">

    <tr>
        <th>Sr.No</th>
        <th>Name</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Position</th>
        <th>Applied On</th>
        <th>Status</th>
        <th>Status Updated</th>
        <th>Interview Date</th>
        <th>Resume</th>
        <th>Action</th>
    </tr>

    <% applications.forEach(function(a,index){ %>

    <tr>

        <td><%= index + 1 %></td>

        <td><%= a.name %></td>

        <td><%= a.email %></td>

        <td><%= a.mobile %></td>

        <td><%= a.position %></td>

        <td>
            <%= a.created_at %>
        </td>

        <td>
            <span class="status-text">
                <%= a.status %>
            </span>
        </td>

        <td>
            <%= a.status_updated_at || '-' %>
        </td>

<td>

    <% if(a.interview_date){ %>

        <%= new Date(a.interview_date).toLocaleDateString('en-IN') %>

        <br>

        <small>
            <%= new Date(a.interview_date).toLocaleTimeString('en-IN',{
                hour:'2-digit',
                minute:'2-digit'
            }) %>
        </small>

    <% } else if(a.status === 'Interview Scheduled'){ %>

        <a href="/admin/interview-form/<%= a.id %>"
           class="status-btn interview-btn">
            Select Date
        </a>

    <% } else { %>

        -

    <% } %>

</td>

        <td>

            <a class="view-btn"
               href="/resume/<%= a.resume %>"
               target="_blank">

               View Resume

            </a>

        </td>

        <td style="min-width:220px;">

            <div class="action-box">

                <a href="/admin/change-status/<%= a.id %>/Under Review"
                   class="status-btn review-btn">
                    Review
                </a>

                <a href="/admin/change-status/<%= a.id %>/Shortlisted"
                   class="status-btn shortlist-btn">
                    Shortlist
                </a>

                <a href="/admin/change-status/<%= a.id %>/Interview Scheduled"
                   class="status-btn interview-btn">
                    Interview
                </a>

                <a href="/admin/change-status/<%= a.id %>/Selected"
                   class="status-btn selected-btn">
                    Selected
                </a>

                <a href="/admin/delete-application/<%= a.id %>"
                   class="delete-btn"
                   onclick="return confirm('Delete Application?')">
                    Delete
                </a>

            </div>

        </td>

    </tr>

    <% }) %>

</table>

<div id="pagination" style="text-align:center; margin-top:20px;"></div>

</div>
<script>

// Search Candidate Name

document.getElementById("searchInput").addEventListener("keyup", function(){

    let filter = this.value.toLowerCase();

    let rows = document.querySelectorAll("#applicationTable tr");

    rows.forEach((row,index)=>{

        if(index === 0) return; // Header Skip

        let name = row.cells[2].innerText.toLowerCase();

        if(name.includes(filter)){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

});


// CSV Download

function downloadCSV(){

    let csv = [];
    let rows = document.querySelectorAll("#applicationTable tr");

    rows.forEach((row)=>{

        let cols = row.querySelectorAll("td,th");

        let rowData = [];

        cols.forEach((col)=>{
            rowData.push('"' + col.innerText + '"');
        });

        csv.push(rowData.join(","));

    });

    let blob = new Blob([csv.join("\n")],{
        type:"text/csv"
    });

    let link = document.createElement("a");

    link.href = URL.createObjectURL(blob);

    link.download = "job_applications.csv";

    link.click();

}


// Print Table

function printTable(){

    let table = document.getElementById("applicationTable").outerHTML;

    let win = window.open("", "", "width=1200,height=700");

    win.document.write(`
        <html>
        <head>
            <title>Job Applications</title>
            <style>
                table{
                    width:100%;
                    border-collapse:collapse;
                }
                th,td{
                    border:1px solid #000;
                    padding:8px;
                    text-align:center;
                }
            </style>
        </head>
        <body>

            <h2>Job Applications</h2>

            ${table}

        </body>
        </html>
    `);

    win.document.close();
    win.print();

}

// Interview Schedule Success Popup

window.addEventListener("load", function(){

    const params = new URLSearchParams(window.location.search);

    if(params.get("schedule")){

        let popup = document.createElement("div");

        popup.innerHTML = "✅ Interview Scheduled Successfully";

        popup.style.position = "fixed";
        popup.style.top = "50%";
        popup.style.left = "50%";
        popup.style.transform = "translate(-50%, -50%)";
        popup.style.background = "#198754";
        popup.style.color = "#fff";
        popup.style.padding = "20px 35px";
        popup.style.borderRadius = "12px";
        popup.style.fontSize = "18px";
        popup.style.fontWeight = "600";
        popup.style.textAlign = "center";
        popup.style.boxShadow = "0 5px 20px rgba(0,0,0,0.3)";
        popup.style.zIndex = "99999";

        document.body.appendChild(popup);

        setTimeout(function(){

            popup.remove();

            window.history.replaceState(
                {},
                document.title,
                window.location.pathname
            );

        },3000);

    }

});

// Pagination

const rowsPerPage = 10;
const table = document.getElementById("applicationTable");
const rows = table.querySelectorAll("tr:not(:first-child)");
const pagination = document.getElementById("pagination");

let currentPage = 1;

function displayRows(page){

    rows.forEach((row,index)=>{

        if(
            index >= (page - 1) * rowsPerPage &&
            index < page * rowsPerPage
        ){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

}

function setupPagination(){

    pagination.innerHTML = "";

    let pageCount = Math.ceil(rows.length / rowsPerPage);

    for(let i = 1; i <= pageCount; i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        btn.style.margin = "5px";
        btn.style.padding = "8px 12px";
        btn.style.border = "none";
        btn.style.borderRadius = "5px";
        btn.style.background = "#2E7D32";
        btn.style.color = "#fff";
        btn.style.cursor = "pointer";

        btn.addEventListener("click", function(){

            currentPage = i;

            displayRows(currentPage);

        });

        pagination.appendChild(btn);

    }

}

displayRows(currentPage);
setupPagination();
</script>
<%- include("footer.ejs") %>