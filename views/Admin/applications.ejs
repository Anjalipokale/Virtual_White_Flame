<%- include("navbar.ejs") %>

<style>

body{
    background:#f4f6f9;
    font-family:Arial,sans-serif;
}

/* Main Container */

.table-box{
    width:78%;
    margin-top:80px;
    margin-bottom:80px;
    margin-left:280px;
    margin-right:0;
    background:#fff;
    padding:15px;
    border-radius:12px;
    box-shadow:0 4px 15px rgba(0,0,0,0.1);
    overflow-x:auto;
}

.table-box h2{
    text-align:center;
    color:#2E7D32;
    margin-bottom:20px;
}

/* Table */

table{
    width:100%;
    border-collapse:collapse;
    text-align:center;
    font-size:13px;
}

th{
    background:#2E7D32;
    color:#fff;
    padding:10px 6px;
    font-size:13px;
    white-space:nowrap;
}

td{
    padding:8px 6px;
    border-bottom:1px solid #e0e0e0;
    vertical-align:middle;
    font-size:12px;
}

tr:hover{
    background:#f9f9f9;
}

/* Status */

.status-text{
    color:#2E7D32;
    font-weight:bold;
}

/* Resume Button */

.view-btn{
    background:#2196F3;
    color:#fff;
    text-decoration:none;
    padding:6px 10px;
    border-radius:5px;
    font-size:11px;
    display:inline-block;
}

.view-btn:hover{
    background:#1565C0;
}

/* Action Buttons */

.action-box{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:4px;
}

.status-btn,
.delete-btn{
    text-decoration:none;
    color:#fff;
    min-width:80px;
    padding:6px 8px;
    border-radius:5px;
    font-size:10px;
    font-weight:600;
    text-align:center;
    transition:.3s;
}

.review-btn{
    background:#ff9800;
}

.review-btn:hover{
    background:#f57c00;
}

.shortlist-btn{
    background:#2196f3;
}

.shortlist-btn:hover{
    background:#1976d2;
}

.interview-btn{
    background:#9c27b0;
}

.interview-btn:hover{
    background:#7b1fa2;
}

.selected-btn{
    background:#2e7d32;
}

.selected-btn:hover{
    background:#1b5e20;
}

.delete-btn{
    background:#e53935;
}

.delete-btn:hover{
    background:#c62828;
}

/* Mobile */

@media(max-width:768px){

    .table-box{
        width:95%;
        margin:20px auto;
    }

    table{
        font-size:11px;
    }

    th,
    td{
        padding:6px 4px;
    }

}

</style>

<div class="table-box">


<h2>Job Applications</h2>

<table>

    <tr>
        <th>ID</th>
        <th>Application ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Position</th>
        <th>Status</th>
        <th>Resume</th>
        <th>Action</th>
    </tr>

    <% applications.forEach(function(a){ %>

    <tr>

        <td><%= a.id %></td>

        <td><%= a.application_id %></td>

        <td><%= a.name %></td>

        <td><%= a.email %></td>

        <td><%= a.mobile %></td>

        <td><%= a.position %></td>

        <td>
            <span class="status-text">
                <%= a.status %>
            </span>
        </td>
 
        <td>
            <a class="view-btn"
               href="/resume/<%= a.resume %>"
               target="_blank">
                View Resume
            </a>
        </td>

        <td style="min-width:220px;">

            <div class="action-box">

                <a href="/admin/change-status/<%= a.id %>/Under Review"
                   class="status-btn review-btn">
                    Review
                </a>

                <a href="/admin/change-status/<%= a.id %>/Shortlisted"
                   class="status-btn shortlist-btn">
                    Shortlist
                </a>

                <a href="/admin/change-status/<%= a.id %>/Interview Scheduled"
                   class="status-btn interview-btn">
                    Interview
                </a>

                <a href="/admin/change-status/<%= a.id %>/Selected"
                   class="status-btn selected-btn">
                    Selected
                </a>

                <a href="/admin/delete-application/<%= a.id %>"
                   class="delete-btn"
                   onclick="return confirm('Delete Application?')">
                    Delete
                </a>

            </div>

        </td>

    </tr>

    <% }) %>

</table>


</div>

<%- include("footer.ejs") %>
