<%- include("navbar.ejs") %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.products-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.page-title{
    color:#198754;
    font-weight:700;
    margin:0;
}

.add-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:10px 20px;
    border-radius:8px;
    text-decoration:none;
    font-weight:600;
    transition:.3s;
}

.add-btn:hover{
    background:#e55f00;
    color:#fff;
}

.table{
    margin-top:20px;
}

.table th{
    background:#198754;
    color:#fff;
    padding:14px;
    text-align:center;
}

.table td{
    padding:14px;
    text-align:center;
    vertical-align:middle;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.product-img{
    width:80px;
    height:80px;
    object-fit:cover;
    border-radius:10px;
    border:2px solid #198754;
}

.edit-btn{
    background:#198754;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.edit-btn:hover{
    background:#146c43;
    color:#fff;
}

.delete-btn{
    background:#ff6b00;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

.description-cell{
    max-width:300px;
}

@media(max-width:992px){
    .products-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }

    .top-header{
        flex-direction:column;
        gap:15px;
        align-items:flex-start !important;
    }
}
.top-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin:20px 0;
    flex-wrap:wrap;
}

.top-actions input{
    width:300px;
    padding:10px;
    border:1px solid #ccc;
    border-radius:8px;
}

.top-actions button{
    background:#198754;
    color:#fff;
    border:none;
    padding:10px 18px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.top-actions button:hover{
    background:#146c43;
}
</style>

<div class="products-container">

    <div class="admin-card">

        <div class="d-flex justify-content-between align-items-center top-header">

            <h2 class="page-title">
                Manage Products
            </h2>

            <div class="top-actions">

    <input
        type="text"
        id="searchInput"
        placeholder="Search Product Name..."
    >

    <button onclick="downloadCSV()">CSV</button>

    <button onclick="printTable()">Print</button>

</div>

            <a href="/admin/add-product"
               class="add-btn">
                Add New Product
            </a>

        </div>

        <div class="table-responsive">
<table class="table" id="productTable">

                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th width="220">Action</th>
                    </tr>
                </thead>

                <tbody>

<% products.forEach(function(product,index){ %>

<tr>

    <td><%= index + 1 %></td>

    <td>
        <img src="/uploads/<%= product.main_image %>"
             class="product-img">
    </td>

    <td><%= product.product_name %></td>

    <td class="description-cell">
        <%= product.short_description %>
    </td>

    
        <td>

    <a href="/admin/edit-product/<%= product.id %>"
       class="edit-btn">
        Edit
    </a>

    <a href="/admin/delete-product/<%= product.id %>"
       class="delete-btn"
       onclick="return confirm('Are you sure you want to delete this product?')">
        Delete
    </a>

</td>
    

</tr>

<% }) %>

</tbody>

            </table>

        </div>

    </div>

</div>
<script>

// Search Product Name

document.getElementById("searchInput").addEventListener("keyup", function(){

    let filter = this.value.toLowerCase();

    let rows = document.querySelectorAll("#productTable tbody tr");

    rows.forEach((row)=>{

        let productName = row.cells[2].innerText.toLowerCase();

        if(productName.includes(filter)){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

});


// CSV Export

function downloadCSV(){

    let csv = [];
    let rows = document.querySelectorAll("#productTable tr");

    rows.forEach((row)=>{

        let cols = row.querySelectorAll("td,th");
        let rowData = [];

        cols.forEach((col)=>{
            rowData.push('"' + col.innerText + '"');
        });

        csv.push(rowData.join(","));

    });

    let blob = new Blob([csv.join("\n")],{
        type:"text/csv"
    });

    let link = document.createElement("a");

    link.href = URL.createObjectURL(blob);

    link.download = "products.csv";

    link.click();

}


// Print Table

function printTable(){

    let table = document.getElementById("productTable").outerHTML;

    let win = window.open("", "", "width=1000,height=700");

    win.document.write(`
        <html>
        <head>
            <title>Products List</title>
            <style>
                table{
                    width:100%;
                    border-collapse:collapse;
                }
                th,td{
                    border:1px solid #000;
                    padding:10px;
                    text-align:center;
                }
                img{
                    width:80px;
                }
            </style>
        </head>
        <body>
            <h2>Manage Products</h2>
            ${table}
        </body>
        </html>
    `);

    win.document.close();
    win.print();

}

</script>

<%- include("footer.ejs") %>