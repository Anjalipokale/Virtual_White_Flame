<%- include('navbar.ejs') %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.history-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:50px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-label{
    font-weight:600;
    margin-bottom:8px;
}

.form-control{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.preview-image{
    width:140px;
    height:140px;
    object-fit:cover;
    border-radius:12px;
    border:2px solid #198754;
    padding:5px;
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

@media(max-width:992px){
    .history-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}
</style>

<div class="history-container">

    <div class="admin-card">

        <h2 class="section-title">
            Company History
        </h2>

        <form action="/admin/save_company_history"
              method="post"
              enctype="multipart/form-data">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        History Image
                    </label>

                    <input type="file"
                           name="history_image"
                           class="form-control">

                </div>

                <div class="col-md-6 mb-3">

                    <% if(history && history.history_image){ %>

                    <label class="form-label">
                        Current Image
                    </label>

                    <div>
                        <img src="/uploads/<%= history.history_image %>"
                             class="preview-image">
                    </div>

                    <% } %>

                </div>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Badge Text
                </label>

                <input type="text"
                       name="history_badge"
                       class="form-control"
                       placeholder="Ex. Since 2013"
                       value="<%= history ? history.history_badge : '' %>">

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Main Heading
                </label>

                <input type="text"
                       name="history_title"
                       class="form-control"
                       placeholder="Enter Main Heading"
                       value="<%= history ? history.history_title : '' %>">

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Paragraph 1
                </label>

                <textarea name="para1"
                          rows="3"
                          class="form-control"
                          placeholder="Enter First Paragraph"><%= history ? history.para1 : '' %></textarea>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Paragraph 2
                </label>

                <textarea name="para2"
                          rows="3"
                          class="form-control"
                          placeholder="Enter Second Paragraph"><%= history ? history.para2 : '' %></textarea>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Paragraph 3
                </label>

                <textarea name="para3"
                          rows="3"
                          class="form-control"
                          placeholder="Enter Third Paragraph"><%= history ? history.para3 : '' %></textarea>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Paragraph 4
                </label>

                <textarea name="para4"
                          rows="3"
                          class="form-control"
                          placeholder="Enter Fourth Paragraph"><%= history ? history.para4 : '' %></textarea>

            </div>

            <button type="submit" class="save-btn w-100">
                Save / Update
            </button>

        </form>

    </div>

</div>

<%- include('footer.ejs') %>