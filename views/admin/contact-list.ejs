<%- include("Navbar") %>

<style>

.contact-box{
    width: 80%;
    margin-top: 100px;
    margin-left: 280px;
    margin-right: auto;
    text-align: center;
    margin-bottom: 90px;
}

.contact-box h2{
    color: #003366;
    font-size: 32px;
    margin-bottom: 25px;
}

table{
    width: 100%;
    border-collapse: collapse;
    box-shadow: 0 0 15px #ccc;
}

table th{
    background: #289341;
    color: white;
    padding: 15px;
}

table td{
    padding: 12px;
    background: #f9f9f9;
}

table tr:hover td{
    background: #e6f2ff;
}

.delete-btn{
    background: #e53935;
    color: white;
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 5px;
    font-weight: bold;
}

.delete-btn:hover{
    background: #b71c1c;
}
.top-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
    flex-wrap:wrap;
}

.top-actions input{
    width:300px;
    padding:10px;
    border:1px solid #ccc;
    border-radius:8px;
}

.top-actions button{
    background:#289341;
    color:#fff;
    border:none;
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.top-actions button:hover{
    background:#1e7a35;
}

</style>


<div class="contact-box">

<h2>Contact Messages</h2>
<div class="top-actions">

    <input
        type="text"
        id="searchInput"
        placeholder="Search Name..."
    >

    <button onclick="downloadCSV()">CSV</button>

    <button onclick="printTable()">Print</button>

</div>

<table border="1" id="contactTable">

<tr>
    <th>ID</th>
    <th>Name</th>
    <th>Email</th>
    <th>Phone</th>
    <th>Subject</th>
    <th>Message</th>
    <th>Date</th>
    <th>Action</th>
</tr>


<% data.forEach(function(item,index){ %>

<tr>

    <td><%= index + 1 %></td>

    <td><%= item.name %></td>
    <td><%= item.email %></td>
    <td><%= item.phone %></td>
    <td><%= item.subject %></td>
    <td><%= item.message %></td>
    <td><%= item.indian_time %></td>

    <td>
        <a href="/admin/delete-contact/<%= item.id %>" class="delete-btn">
            Delete
        </a>
    </td>

</tr>

<% }) %>

</table>
<div id="pagination" style="text-align:center; margin-top:20px;"></div>

</div>

<script>

// Search By Name

document.getElementById("searchInput").addEventListener("keyup", function(){

    let filter = this.value.toLowerCase();

    let rows = document.querySelectorAll("#contactTable tr");

    rows.forEach((row,index)=>{

        if(index === 0) return;

        let name = row.cells[1].innerText.toLowerCase();

        if(name.includes(filter)){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

});


// CSV Download

function downloadCSV(){

    let csv = [];
    let rows = document.querySelectorAll("#contactTable tr");

    rows.forEach((row)=>{

        let cols = row.querySelectorAll("td,th");
        let rowData = [];

        cols.forEach((col)=>{
            rowData.push('"' + col.innerText + '"');
        });

        csv.push(rowData.join(","));

    });

    let blob = new Blob([csv.join("\n")],{
        type:"text/csv"
    });

    let link = document.createElement("a");

    link.href = URL.createObjectURL(blob);
    link.download = "contact_messages.csv";
    link.click();

}


// Print Table

function printTable(){

    let table = document.getElementById("contactTable").outerHTML;

    let win = window.open("", "", "width=1200,height=700");

    win.document.write(`
        <html>
        <head>
            <title>Contact Messages</title>
            <style>
                table{
                    width:100%;
                    border-collapse:collapse;
                }
                th,td{
                    border:1px solid #000;
                    padding:10px;
                    text-align:center;
                }
            </style>
        </head>
        <body>

            <h2>Contact Messages</h2>

            ${table}

        </body>
        </html>
    `);

    win.document.close();
    win.print();

}

// ==========================
// Pagination
// ==========================

const rowsPerPage = 10;
const tableRows = document.querySelectorAll("#contactTable tr:not(:first-child)");
const pagination = document.getElementById("pagination");

let currentPage = 1;

function displayRows(page){

    currentPage = page;

    tableRows.forEach((row,index)=>{

        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;

        if(index >= start && index < end){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

    renderPagination();

}

function renderPagination(){

    let pageCount = Math.ceil(tableRows.length / rowsPerPage);

    pagination.innerHTML = "";

    for(let i=1; i<=pageCount; i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        btn.style.margin = "0 5px";
        btn.style.padding = "8px 15px";
        btn.style.border = "none";
        btn.style.borderRadius = "5px";
        btn.style.cursor = "pointer";

        if(i === currentPage){
            btn.style.background = "#289341";
            btn.style.color = "#fff";
        }else{
            btn.style.background = "#ddd";
        }

        btn.addEventListener("click", function(){
            displayRows(i);
        });

        pagination.appendChild(btn);

    }

}

displayRows(1);

</script>


