<%- include('navbar.ejs') %>

<div class="container" style="margin-top:8rem;">

    <div class="card shadow">

        <div class="card-header text-white"
            style="background:linear-gradient(90deg,#198754,#146c43);">

            <h4 class="mb-0">Add Future Goal</h4>

        </div>

        <div class="card-body">

            <form action="/admin/save_future_goal" method="post">

                <div class="mb-3">
                    <label>Goal Title</label>
                    <input type="text"
                           name="goal_title"
                           class="form-control"
                           placeholder="Enter Goal Title">
                </div>

                <div class="mb-3">
                    <label>Description</label>
                    <textarea name="goal_description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter Description"></textarea>
                </div>

                <button class="btn text-white"
                        style="background:var(--orange);">
                    Save Goal
                </button>

            </form>

        </div>

    </div>

    <br>

    <div class="card shadow">

        <div class="card-header text-white"
            style="background:linear-gradient(90deg,#198754,#146c43);">

            <h4 class="mb-0">All Future Goals</h4>

        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>
                    <th>Sr No</th>
                    <th>Title</th>
                    <th>Description</th>

                    <th width="180">Action</th>
                </tr>

                <% future_goals.forEach(function(f, index){ %>

                <tr>

                    <td><%= index + 1 %></td>
                    <td><%= f.goal_title %></td>
                 <td><%= f.goal_description %></td>


                    <td>

                        <a href="/admin/edit_future_goal/<%= f.id %>"
                           class="btn btn-success btn-sm">
                            Edit
                        </a>

                        <a href="/admin/delete_future_goal/<%= f.id %>"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>

                <% }) %>

            </table>

        </div>

    </div>

</div>

<%- include('footer.ejs') %>