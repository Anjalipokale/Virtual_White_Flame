<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>HR Contact Management</title>
<%- include("navbar.ejs") %>
<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f4f8f4;
}

/* Admin Content Area */
.hr-form-wrapper{
    min-height:100vh;
    margin-top:90px;
    margin-left:260px;   /* Sidebar Width */
    padding:30px;
}

.hr-form-card{
    width:100%;
    background:#fff;
    padding:40px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,0.08);
}

.hr-form-card h2{
    text-align:center;
    color:#2e7d32;
    margin-bottom:30px;
    font-size:32px;
}

.form-group{
    margin-bottom:18px;
}

.form-group label{
    display:block;
    margin-bottom:8px;
    color:#2e7d32;
    font-weight:600;
}

.form-group input{
    width:100%;
    padding:12px 15px;
    border:2px solid #e0e0e0;
    border-radius:10px;
    font-size:15px;
    outline:none;
    transition:.3s;
}

.form-group input:focus{
    border-color:#ff7a00;
}

.save-btn{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:green;
    color:#fff;
    font-size:17px;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

.save-btn:hover{
    opacity:.9;
    transform:translateY(-2px);
}

@media(max-width:768px){

    .hr-form-card{
        padding:25px;
    }

    .hr-form-card h2{
        font-size:26px;
    }

}

</style>
</head>
<body>

<div class="hr-form-wrapper">

    <div class="hr-form-card">

        <h2>HR Contact Management</h2>

        <form action="/admin/hr-contact" method="POST">

            <div class="form-group">
                <label>Phone Card Title</label>
                <input type="text" name="phone_title" placeholder="Call HR">
            </div>

            <div class="form-group">
                <label>Phone Number 1</label>
                <input type="text" name="phone1" placeholder="+91 9876543210">
            </div>

            <div class="form-group">
                <label>Phone Number 2</label>
                <input type="text" name="phone2" placeholder="+91 9876543211">
            </div>

            <div class="form-group">
                <label>Email Card Title</label>
                <input type="text" name="email_title" placeholder="Email HR">
            </div>

            <div class="form-group">
                <label>Email 1</label>
                <input type="email" name="email1" placeholder="hr@virtualwhiteflame.com">
            </div>

            <div class="form-group">
                <label>Email 2</label>
                <input type="email" name="email2" placeholder="careers@virtualwhiteflame.com">
            </div>

            <div class="form-group">
                <label>Hours Card Title</label>
                <input type="text" name="hours_title" placeholder="Working Hours">
            </div>

            <div class="form-group">
                <label>Working Days</label>
                <input type="text" name="working_days" placeholder="Monday - Saturday">
            </div>

            <div class="form-group">
                <label>Working Time</label>
                <input type="text" name="working_time" placeholder="9:00 AM - 6:00 PM">
            </div>

            <button type="submit" class="save-btn">
                Save Information
            </button>

        </form>

    </div>

</div>
<%- include("footer.ejs") %>
</body>
</html>