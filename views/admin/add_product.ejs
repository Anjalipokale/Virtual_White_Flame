<%- include("navbar.ejs") %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content */
.product-container{
    margin-left:270px;
    margin-top:100px;
    margin-right:20px;
    margin-bottom:50px;
    width:calc(100% - 290px);
}

.admin-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.section-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-label{
    font-weight:600;
}

.form-control{
    border-radius:8px;
    padding:12px;
    border:1px solid #ddd;
}

.form-control:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

textarea{
    resize:none;
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

.error{
    color:red;
    font-size:14px;
    margin-top:5px;
}

@media(max-width:992px){
    .product-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}
</style>

<div class="product-container">

    <div class="admin-card">

        <h2 class="section-title">
            Add Product
        </h2>

        <form action="/admin/save-product"
              method="post"
              enctype="multipart/form-data"
              id="productForm">

            <!-- Product Name -->
            <div class="mb-3">
                <label class="form-label">
                    Product Name
                </label>

                <input type="text"
                       name="product_name"
                       id="product_name"
                       class="form-control"
                       required>

                <div class="error" id="productNameError"></div>
            </div>

            <!-- Short Description -->
            <div class="mb-3">
                <label class="form-label">
                    Short Description
                </label>

                <textarea name="short_description"
                          id="short_description"
                          class="form-control"
                          rows="3"
                          required></textarea>

                <div class="error" id="shortDescriptionError"></div>
            </div>

            <!-- Full Description -->
            <div class="mb-3">
                <label class="form-label">
                    Full Description
                </label>

                <textarea name="description"
                          id="description"
                          class="form-control"
                          rows="6"
                          required></textarea>

                <div class="error" id="descriptionError"></div>
            </div>

            <!-- Features -->
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Feature 1
                    </label>

                    <input type="text"
                           name="feature1"
                           class="form-control">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Feature 2
                    </label>

                    <input type="text"
                           name="feature2"
                           class="form-control">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Feature 3
                    </label>

                    <input type="text"
                           name="feature3"
                           class="form-control">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Feature 4
                    </label>

                    <input type="text"
                           name="feature4"
                           class="form-control">
                </div>

            </div>

            <!-- Image -->
            <div class="mb-4">
                <label class="form-label">
                    Main Product Image
                </label>

                <input type="file"
                       name="main_image"
                       id="main_image"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp"
                       required>

                <div class="error" id="imageError"></div>
            </div>

            <button type="submit"
                    class="save-btn">
                Save Product
            </button>

        </form>

    </div>

</div>

<script>
document.getElementById("productForm").addEventListener("submit", function(e){

    let isValid = true;

    // Clear old errors
    document.getElementById("productNameError").innerText = "";
    document.getElementById("shortDescriptionError").innerText = "";
    document.getElementById("descriptionError").innerText = "";
    document.getElementById("imageError").innerText = "";

    let productName = document.getElementById("product_name").value.trim();
    let shortDescription = document.getElementById("short_description").value.trim();
    let description = document.getElementById("description").value.trim();
    let image = document.getElementById("main_image");

    // Product Name Validation
    if(productName.length < 3){
        document.getElementById("productNameError").innerText =
        "Product Name must be at least 3 characters.";
        isValid = false;
    }

    // Short Description Validation
    if(shortDescription.length < 10){
        document.getElementById("shortDescriptionError").innerText =
        "Short Description must be at least 10 characters.";
        isValid = false;
    }

    // Description Validation
    if(description.length < 20){
        document.getElementById("descriptionError").innerText =
        "Full Description must be at least 20 characters.";
        isValid = false;
    }

    // Image Validation
    if(image.files.length === 0){
        document.getElementById("imageError").innerText =
        "Please select an image.";
        isValid = false;
    }else{

        let file = image.files[0];

        let allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        if(!allowedTypes.includes(file.type)){
            document.getElementById("imageError").innerText =
            "Only JPG, PNG and WEBP images are allowed.";
            isValid = false;
        }

        // Max 2MB
        if(file.size > 2 * 1024 * 1024){
            document.getElementById("imageError").innerText =
            "Image size must be less than 2 MB.";
            isValid = false;
        }
    }

    if(!isValid){
        e.preventDefault();
    }
});
</script>

<%- include("footer.ejs") %>