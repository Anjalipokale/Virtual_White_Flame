<%- include("navbar.ejs") %>

<style>

.requests-wrapper{
    width: 80%;
    margin-top: 90px;
    padding:20px;
    margin-left: 250px;
    margin-bottom: 90px;
}

.requests-title{
    text-align:center;
    color:#2E7D32;
    margin-bottom:30px;
    font-size:32px;
    font-weight:700;
}

.requests-table{
    width:100%;
    border-collapse:collapse;
    background:#fff;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
    border-radius:15px;
    overflow:hidden;
}

.requests-table thead{
    background:#2E7D32;
    color:#fff;
}

.requests-table th,
.requests-table td{
    padding:15px;
    text-align:center;
    border-bottom:1px solid #eee;
}

.requests-table tbody tr:hover{
    background:#f8faf8;
}

.requests-table th{
    font-weight:600;
}

@media(max-width:768px){

    .table-responsive{
        overflow-x:auto;
    }

    .requests-title{
        font-size:24px;
    }

}

.btn-accept{
    background:#2E7D32;
    color:#fff;
    padding:8px 14px;
    border-radius:6px;
    text-decoration:none;
    margin-right:8px;
}

.btn-delete{
    background:#e53935;
    color:#fff;
    padding:8px 14px;
    border-radius:6px;
    text-decoration:none;
}

.btn-accept:hover,
.btn-delete:hover{
    opacity:0.9;
}
.top-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
    flex-wrap:wrap;
}

.top-actions input{
    width:300px;
    padding:10px;
    border:1px solid #ccc;
    border-radius:8px;
}

.top-actions button{
    background:#2E7D32;
    color:#fff;
    border:none;
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.top-actions button:hover{
    background:#1B5E20;
}

#pagination button:hover{
    background:#1B5E20 !important;
    color:#fff;
}

</style>

<div class="requests-wrapper">

    <h2 class="requests-title">
        Dealer Inquiry Requests
    </h2>
    <div class="top-actions">

    <input
        type="text"
        id="searchInput"
        placeholder="Search Dealer Name..."
    >

    <button onclick="downloadCSV()">CSV</button>

    <button onclick="printTable()">Print</button>

</div>

    <div class="table-responsive">

        <table class="requests-table" id="dealerTable">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Dealer Name</th>
                    <th>City</th>
                    <th>Mobile</th>
                    <th>Date</th>
                    <th>Action</th>
                    <th>Status</th>
                </tr>
            </thead>

          <tbody>

<% requests.forEach((item,index)=>{ %>

<tr>

    <td><%= index + 1 %></td>

    <td><%= item.dealer_name %></td>

    <td><%= item.city %></td>

    <td><%= item.mobile %></td>

    <td>
        <%= new Date(item.created_at).toLocaleString('en-IN', {
            timeZone: 'Asia/Kolkata',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
        }) %>
    </td>

    <td>

        <a href="/admin/accept-dealer/<%= item.id %>"
           class="btn-accept">
           Accept
        </a>

        <a href="/admin/delete-dealer/<%= item.id %>"
           class="btn-delete"
           onclick="return confirm('Are you sure?')">
           Delete
        </a>

    </td>

    <td>
    <% if(item.status === 'Accepted'){ %>
        <span style="color:green;font-weight:bold;">
            Accepted
        </span>
    <% } else { %>
        <span style="color:orange;font-weight:bold;">
            Pending
        </span>
    <% } %>
    </td>

</tr>

<% }) %>

</tbody>    

        </table>
 <div id="pagination" style="text-align:center; margin-top:20px;"></div>
    </div>

</div>
<script>

// Search Dealer Name

document.getElementById("searchInput").addEventListener("keyup", function(){

    let filter = this.value.toLowerCase();

    let rows = document.querySelectorAll("#dealerTable tbody tr");

    rows.forEach((row)=>{

        let dealerName = row.cells[1].innerText.toLowerCase();

        if(dealerName.includes(filter)){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

});


// CSV Download

function downloadCSV(){

    let csv = [];
    let rows = document.querySelectorAll("#dealerTable tr");

    rows.forEach((row)=>{

        let cols = row.querySelectorAll("td,th");
        let rowData = [];

        cols.forEach((col)=>{
            rowData.push('"' + col.innerText + '"');
        });

        csv.push(rowData.join(","));

    });

    let blob = new Blob([csv.join("\n")],{
        type:"text/csv"
    });

    let link = document.createElement("a");

    link.href = URL.createObjectURL(blob);
    link.download = "dealer_requests.csv";
    link.click();

}


// Print Table

function printTable(){

    let table = document.getElementById("dealerTable").outerHTML;

    let win = window.open("", "", "width=1200,height=700");

    win.document.write(`
        <html>
        <head>
            <title>Dealer Inquiry Requests</title>
            <style>
                table{
                    width:100%;
                    border-collapse:collapse;
                }
                th,td{
                    border:1px solid #000;
                    padding:10px;
                    text-align:center;
                }
            </style>
        </head>
        <body>

            <h2>Dealer Inquiry Requests</h2>

            ${table}

        </body>
        </html>
    `);

    win.document.close();
    win.print();

}


// Existing code ...

// Pagination
const rowsPerPage = 10;
const rows = document.querySelectorAll("#dealerTable tbody tr");
const pagination = document.getElementById("pagination");

let currentPage = 1;

function displayRows(page){

    rows.forEach((row,index)=>{

        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;

        if(index >= start && index < end){
            row.style.display = "";
        }else{
            row.style.display = "none";
        }

    });

}

function setupPagination(){

    let pageCount = Math.ceil(rows.length / rowsPerPage);

    pagination.innerHTML = "";

    for(let i = 1; i <= pageCount; i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        btn.style.margin = "0 5px";
        btn.style.padding = "8px 12px";
        btn.style.border = "none";
        btn.style.borderRadius = "5px";
        btn.style.cursor = "pointer";

        if(i === currentPage){
            btn.style.background = "#2E7D32";
            btn.style.color = "#fff";
        }else{
            btn.style.background = "#ddd";
        }

        btn.addEventListener("click", function(){

            currentPage = i;

            displayRows(currentPage);

            setupPagination();

        });

        pagination.appendChild(btn);

    }

}

displayRows(currentPage);
setupPagination();


</script>


</script>

