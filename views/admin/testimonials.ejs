<%- include("navbar.ejs") %>

<style>
body{
    background:#f5f7f8;
}

/* Main Content Area */
.testimonial-container{
    margin-left:270px; /* Sidebar Width */
    margin-top:100px;
    margin-right:20px;
    margin-bottom:30px;
    width:calc(100% - 290px);
}

.testimonial-card,
.table-card{
    background:#fff;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.testimonial-title{
    color:#198754;
    font-weight:700;
    margin-bottom:25px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.form-group{
    margin-bottom:15px;
}

.form-group input,
.form-group textarea{
    width:100%;
    padding:12px;
    border:1px solid #ddd;
    border-radius:8px;
    outline:none;
    font-size:15px;
}

.form-group input:focus,
.form-group textarea:focus{
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.form-group textarea{
    height:120px;
    resize:none;
}

.save-btn{
    background:#ff6b00;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    font-weight:600;
    transition:.3s;
}

.save-btn:hover{
    background:#e55f00;
}

.table-card{
    margin-top:30px;
}

.table-title{
    color:#198754;
    font-weight:700;
    margin-bottom:20px;
    border-bottom:2px solid #198754;
    padding-bottom:10px;
}

.table{
    width:100%;
    border-collapse:collapse;
}

.table th{
    background:#198754;
    color:#fff;
    padding:14px;
    text-align:center;
}

.table td{
    padding:14px;
    text-align:center;
    border-bottom:1px solid #eee;
    vertical-align:middle;
}

.table tbody tr:hover{
    background:#f8f9fa;
}

.logo-img{
    width:70px;
    height:70px;
    object-fit:contain;
    border:2px solid #198754;
    border-radius:10px;
    padding:5px;
}

.delete-btn{
    background:red;
    color:#fff;
    padding:8px 15px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
}

.delete-btn:hover{
    background:#e55f00;
    color:#fff;
}

.table-responsive{
    overflow-x:auto;
}

@media(max-width:992px){
    .testimonial-container{
        margin-left:20px;
        margin-right:20px;
        width:auto;
    }
}

#pagination button:hover{
    background:#ff6b00 !important;
}
</style>

<div class="testimonial-container">

    <!-- Form Card -->
    <div class="testimonial-card">

        <h2 class="testimonial-title">
            Add Testimonial
        </h2>

        <form action="/admin/save-testimonial"
              method="POST"
              enctype="multipart/form-data">

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <input type="text"
                               name="company_name"
                               placeholder="Company Name"
                               required>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <input type="text"
                               name="city"
                               placeholder="City"
                               required>
                    </div>
                </div>

            </div>

            <div class="form-group">
                <textarea name="description"
                          placeholder="Description"
                          required></textarea>
            </div>

            <div class="form-group">
                <input type="file"
                       name="image"
                       required>
            </div>

            <button type="submit" class="save-btn">
                Save Testimonial
            </button>

        </form>

    </div>

    <!-- Table Card -->
    <div class="table-card">

        <h3 class="table-title">
            Testimonials List
        </h3>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Logo</th>
                        <th>Company</th>
                        <th>City</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                <% testimonials.forEach((t,index)=>{ %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td>
                            <img src="/uploads/<%= t.image %>"
                                 class="logo-img">
                        </td>

                        <td><%= t.company_name %></td>

                        <td><%= t.city %></td>

                        <td>
                            <a href="/admin/delete-testimonial/<%= t.id %>"
                               class="delete-btn"
                               onclick="return confirm('Delete Testimonial?')">
                                Delete
                            </a>
                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>
            <div id="pagination" style="text-align:center; margin-top:20px;"></div>

        </div>

    </div>

</div>
<script>

// Testimonial Pagination

const rowsPerPage = 10;
const tableRows = document.querySelectorAll(".table tbody tr");
const pagination = document.getElementById("pagination");

let currentPage = 1;

function showPage(page){

    currentPage = page;

    tableRows.forEach((row,index)=>{

        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;

        if(index >= start && index < end){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

    updateButtons();
}

function updateButtons(){

    let buttons = pagination.querySelectorAll("button");

    buttons.forEach(btn=>{
        btn.style.background = "#198754";
    });

    if(buttons[currentPage - 1]){
        buttons[currentPage - 1].style.background = "#ff6b00";
    }

}

function createPagination(){

    let totalPages = Math.ceil(tableRows.length / rowsPerPage);

    pagination.innerHTML = "";

    for(let i=1;i<=totalPages;i++){

        let btn = document.createElement("button");

        btn.innerText = i;

        btn.style.margin = "5px";
        btn.style.padding = "8px 14px";
        btn.style.border = "none";
        btn.style.borderRadius = "6px";
        btn.style.color = "#fff";
        btn.style.cursor = "pointer";
        btn.style.background = "#198754";

        btn.addEventListener("click", function(){
            showPage(i);
        });

        pagination.appendChild(btn);
    }

}

createPagination();
showPage(1);

</script>
<%- include("footer.ejs") %>