<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
<link rel="stylesheet" href="/css/support_services.css">
<link rel="stylesheet" href="/js/script.js">
<!-- section 1 -->
<section class="support-services">
    <div class="container">
        <h2>Support Services</h2>

        <div class="support-grid">

            <div class="support-card">
                <div class="icon">📞</div>
                <h3>Request Callback</h3>
                <p>Schedule a callback from our support team.</p>
                <a href="#" class="btn">Request Now</a>
            </div>

            <div class="support-card">
                <div class="icon">💬</div>
                <h3>WhatsApp Support</h3>
                <p>Get instant assistance through WhatsApp.</p>
                <a href="#" class="btn">Chat Now</a>
            </div>

            <div class="support-card">
                <div class="icon">🤝</div>
                <h3>Dealer Inquiry</h3>
                <p>Become our authorized dealer or partner.</p>
                <a href="#" class="btn">Apply Now</a>
            </div>

            <div class="support-card">
                <div class="icon">🌍</div>
                <h3>Regional Contact</h3>
                <p>Connect with your nearest regional office.</p>
                <a href="#" class="btn">Contact</a>
            </div>

        </div>
    </div>
</section>

<!-- section 2 -->
 <section class="contact-support">
    <div class="container">
        <h2>Need More Help?</h2>

        <form class="support-form">
            <input type="text" placeholder="Your Name" required>
            <input type="tel" placeholder="Phone Number" required>
            <input type="email" placeholder="Email Address" required>
            <textarea rows="5" placeholder="Your Message"></textarea>

            <button type="submit">Submit Inquiry</button>
        </form>
    </div>
</section>

<!-- section 3 -->
 <section class="why-support">
    <div class="container">
        <h2>Why Choose Our Support?</h2>

        <div class="features">
            <div class="feature-box">
                <h3>⚡ Quick Response</h3>
            </div>

            <div class="feature-box">
                <h3>🎯 Expert Assistance</h3>
            </div>

            <div class="feature-box">
                <h3>👨‍💼 Dedicated Team</h3>
            </div>

            <div class="feature-box">
                <h3>🌍 Pan India Support</h3>
            </div>
        </div>
    </div>
</section>


<!-- section 4 -->
 <section class="support-cta">
    <div class="container">
        <h2>Need Immediate Assistance?</h2>
        <p>Our team is ready to help you.</p>

        <div class="cta-buttons">
            <a href="tel:+919999999999">📞 Call Now</a>
            <a href="https://wa.me/919999999999">💬 WhatsApp</a>
            <a href="mailto:info@example.com">📧 Email Us</a>
        </div>
    </div>
</section>

