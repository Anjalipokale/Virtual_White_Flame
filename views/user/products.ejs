<%- include("navbar.ejs") %>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
<link rel="stylesheet" href="/css/product.css">

<section class="pro_banner d-flex justify-content-center align-items-center">
    <h1 class="text-white fw-bold display-3 bg-dark bg-opacity-50 text-white px-4 py-2 rounded">
        Products
    </h1>
</section>

<section class="products">

     <% products.forEach(function(product){ %>

<a href="/product/<%= product.id %>" class="product-card">

    <div class="product-image">

        <img
        src="/uploads/<%= product.main_image %>"
        alt="<%= product.product_name %>">

        <div class="view-overlay">
            <span>👁 View Details</span>
        </div>

    </div>

    <div class="product-content">

        <h3>
            <%= product.product_name %>
        </h3>

        <p>
            <%= product.short_description %>
        </p>

        <span class="know-more">
            Add Product
        </span>

    </div>

</a>

<% }) %>

    
</section>
<!-- Raw Material Products -->
<section class="raw-material">

    <h2>Raw Material Products</h2>

    <div class="raw-material-grid">

        <% rawmaterials.forEach(function(item){ %>

<div class="raw-card">

    <img
        src="/uploads/<%= item.image %>"
        alt="<%= item.name %>"
    >

    <h3><%= item.name %></h3>

</div>

<% }) %>


    </div>

</section>
<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <a href="tel:+919420950022"
       class="call-btn">
        <i class="fa-solid fa-phone"></i>
    </a>

</div>

<%- include("footer.ejs") %>