<!-- =================== BIOMASS vs COAL =================== -->
<section class="section transparent-bg">
  <div class="sec-eyebrow">Side by side</div>
  <div class="sec-title">Biomass vs Coal Comparison</div>
  <div class="sec-bar"></div>
  <div class="compare-wrap">
    <table class="compare-table">
      <thead>
        <tr>
          <th>Parameter</th>
          <th class="biomass-col">🌿 Biomass Briquettes / Pellets</th>
          <th class="coal-col">🏭 Coal</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Calorific Value</td>
          <td><span class="badge good">3,800 – 4,200 kcal/kg</span></td>
          <td><span class="badge mid">4,500 – 6,000 kcal/kg</span></td>
        </tr>
        <tr>
          <td>CO₂ Emissions</td>
          <td><span class="badge good">Carbon Neutral</span></td>
          <td><span class="badge bad">Very High</span></td>
        </tr>
        <tr>
          <td>Sulphur Content</td>
          <td><span class="badge good">Near Zero (&lt;0.1%)</span></td>
          <td><span class="badge bad">0.5% – 3%</span></td>
        </tr>
        <tr>
          <td>Ash Content</td>
          <td><span class="badge good">2% – 5%</span></td>
          <td><span class="badge bad">10% – 20%</span></td>
        </tr>
        <tr>
          <td>Cost (per ton)</td>
          <td><span class="badge good">₹4,500 – ₹6,000</span></td>
          <td><span class="badge bad">₹8,000 – ₹12,000</span></td>
        </tr>
        <tr>
          <td>Government Subsidy</td>
          <td><span class="badge good">Available (Renewable)</span></td>
          <td><span class="badge bad">Not Available</span></td>
        </tr>
        <tr>
          <td>Storage</td>
          <td><span class="badge good">Easy, weatherproof</span></td>
          <td><span class="badge mid">Needs large open area</span></td>
        </tr>
        <tr>
          <td>Boiler Maintenance</td>
          <td><span class="badge good">Low — clean burning</span></td>
          <td><span class="badge bad">High — heavy soot</span></td>
        </tr>
        <tr>
          <td>Pollution Norms</td>
          <td><span class="badge good">Compliant</span></td>
          <td><span class="badge bad">Increasingly restricted</span></td>
        </tr>
        <tr>
          <td>Supply Reliability</td>
          <td><span class="badge good">Local & consistent</span></td>
          <td><span class="badge mid">Import dependent</span></td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="compare-note">* Values are approximate averages. Actual figures vary by product grade and region.</p>
</section>

<!-- =================== CALCULATORS =================== -->
<section class="section alt">
  <div class="sec-eyebrow">Try it yourself</div>
  <div class="sec-title">Interactive Calculators</div>
  <div class="sec-bar"></div>
  <div class="calc-grid">

    <!-- ROI Calculator -->
    <div class="calc-card" id="roi-card">
      <div class="calc-head">
        <div class="calc-head-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="calc-head-text">
          <h3>ROI Calculator</h3>
          <p>Monthly fuel savings & payback period</p>
        </div>
      </div>
      <div class="calc-body">
        <div class="field-row">
          <div class="field">
            <label>Monthly Coal Usage (tons)</label>
            <input type="number" id="coal-tons" placeholder="e.g. 50" min="1"/>
          </div>
          <div class="field">
            <label>Coal Price (₹/ton)</label>
            <input type="number" id="coal-price" placeholder="e.g. 9000" min="1"/>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Biomass Price (₹/ton)</label>
            <input type="number" id="bio-price" placeholder="e.g. 5500" min="1"/>
          </div>
          <div class="field">
            <label>Biomass Efficiency Factor</label>
            <select id="eff-factor">
              <option value="1.15">High (1.15x)</option>
              <option value="1.10" selected>Medium (1.10x)</option>
              <option value="1.05">Standard (1.05x)</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label>Switchover Investment (₹)</label>
          <input type="number" id="invest" placeholder="e.g. 200000" min="0"/>
        </div>
        <button class="calc-btn" onclick="calcROI()">Calculate Savings ▶</button>
        <div class="calc-result" id="roi-result">
          <div class="result-row"><span class="result-label">Monthly Coal Cost</span><span class="result-val" id="r-coal-cost">—</span></div>
          <div class="result-row"><span class="result-label">Monthly Biomass Cost</span><span class="result-val" id="r-bio-cost">—</span></div>
          <div class="result-row"><span class="result-label">Monthly Savings</span><span class="result-val highlight" id="r-monthly-save">—</span></div>
          <div class="result-row"><span class="result-label">Annual Savings</span><span class="result-val highlight" id="r-annual-save">—</span></div>
          <div class="result-row"><span class="result-label">Payback Period</span><span class="result-val" id="r-payback">—</span></div>
        </div>
      </div>
    </div>

    <!-- Carbon Footprint Calculator -->
    <div class="calc-card" id="carbon-card">
      <div class="calc-head">
        <div class="calc-head-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="calc-head-text">
          <h3>Carbon Footprint Calculator</h3>
          <p>CO₂ saved by switching to biomass</p>
        </div>
      </div>
      <div class="calc-body">
        <div class="field">
          <label>Monthly Fuel Usage (tons)</label>
          <input type="number" id="cf-usage" placeholder="e.g. 50" min="1"/>
        </div>
        <div class="field">
          <label>Current Fuel Type</label>
          <select id="cf-fuel">
            <option value="2.42">Coal (2.42 kg CO₂/kg)</option>
            <option value="2.68">Lignite (2.68 kg CO₂/kg)</option>
            <option value="2.01">Diesel (2.01 kg CO₂/litre)</option>
            <option value="1.89">Furnace Oil (1.89 kg CO₂/kg)</option>
          </select>
        </div>
        <div class="field">
          <label>Industry Type</label>
          <select id="cf-industry">
            <option value="1.0">Food Processing</option>
            <option value="1.1">Textile / Dyeing</option>
            <option value="1.2">Chemical / Pharma</option>
            <option value="0.9">Dairy / Beverage</option>
            <option value="1.15">Paper / Packaging</option>
          </select>
        </div>
        <button class="calc-btn" onclick="calcCarbon()">Calculate CO₂ Saved ▶</button>
        <div class="calc-result orange-result" id="carbon-result">
          <div class="result-row"><span class="result-label">Current CO₂ Emission / month</span><span class="result-val" id="cf-current">—</span></div>
          <div class="result-row"><span class="result-label">Biomass CO₂ (residual)</span><span class="result-val" id="cf-bio">—</span></div>
          <div class="result-row"><span class="result-label">CO₂ Saved / month</span><span class="result-val highlight" id="cf-saved">—</span></div>
          <div class="result-row"><span class="result-label">CO₂ Saved / year</span><span class="result-val highlight" id="cf-annual">—</span></div>
          <div class="result-row"><span class="result-label">Equivalent Trees Planted</span><span class="result-val" id="cf-trees">—</span></div>
        </div>
      </div>
    </div>

  </div>
</section>

