<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <title>Contact Us | Virtual White Flame</title>
    <link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/css/contact.css">
    <link rel="stylesheet" href="/css/web.css">
</head>
<body>

    <%- include('navbar') %>

    <!-- Hero Section -->

<!-- Banner -->
<section class="pro_banner">
    <div class="banner-overlay"></div>

    <div class="banner-content">
        <h1>Contact Us</h1>

        <div class="breadcrumb">
            <a href="/">Home</a>
            <span>></span>
            <span>Contact Us</span>
        </div>
    </div>
</section>

   <!-- Quick Contact Cards -->

<section class="quick-contact">

    <div class="contact-card">

        <div class="contact-icon">
            <i class="fas fa-headset"></i>
        </div>

        <h3>Call Us</h3>

        <a href="tel:9423390308" class="contact-link">
    9423390308
</a>

<a href="tel:9420950022" class="contact-link">
    9420950022
</a>
    </div>

    <div class="contact-card">

        <div class="contact-icon">
            <i class="fas fa-envelope"></i>
        </div>

        <h3>Email Us</h3>

        <a href="mailto:sales@virtualwhiteflame.com"
   class="contact-link">
   sales@virtualwhiteflame.com
</a>

<a href="mailto:operation.virtualwhiteflame@gmail.com"
   class="contact-link">
   operation.virtualwhiteflame@gmail.com
</a>

    </div>

   <div class="contact-card">

    <div class="contact-icon">
        <i class="fas fa-map-marker-alt"></i>
    </div>

    <h3>Regional Contact</h3>

    <p>Ahmednagar Office</p>
    <p>Navi Mumbai Office</p>

</div>

    <div class="contact-card">

    <div class="contact-icon">
        <i class="fas fa-handshake"></i>
    </div>

   <h3>Dealer Inquiry</h3>

<p>Become a Dealer</p>

<button class="dealer-btn" id="openDealerModal">
    Enquire Now
</button>

</div>

</section>

   
     <!-- Contact Form & Callback -->

<section class="contact-section" id="contact-form">

    <div class="contact-container">

        <!-- Contact Form -->

        <div class="contact-form-box">

            <div class="section-title">
                <span>Send Message</span>
                <h2>Get In Touch With Us</h2>
            </div>

            <form>

                <div class="input-row">
                    <input type="text" placeholder="Full Name" required>
                    <input type="email" placeholder="Email Address" required>
                </div>

                <div class="input-row">
                    <input type="tel" placeholder="Phone Number" required>
                    <input type="text" placeholder="Subject">
                </div>

                <textarea rows="6"
                    placeholder="Write your message here..."
                    required></textarea>

                <button type="submit" class="send-btn">
                    Send Message
                </button>

            </form>

        </div>

        <!-- Callback Card -->

        <div class="callback-card">

            <div class="callback-icon">
                <i class="fas fa-phone-volume"></i>
            </div>

            <h3>Request A Callback</h3>

            <p>
                Leave your details and our team
                will contact you shortly.
            </p>

            <input type="text" placeholder="Your Name">

            <input type="tel" placeholder="Mobile Number">

            <input type="text" placeholder="Preferred Time">

            <button class="callback-btn">
                Request Callback
            </button>

        </div>

    </div>

</section>

    


    <!-- Office Locations -->

    

<section class="office-section">

    <div class="section-title center-title">
        <span>Regional Contacts</span>
        <h2>Our Office Locations</h2>
    </div>

    <div class="office-grid">

        <!-- Ahmednagar -->

     <div class="office-card">

    <div class="office-icon">
        <i class="fas fa-location-dot"></i>
    </div>

    <h3>Head Office</h3>

    <p class="office-address">
        Flat no.2, Plot No.1,<br>
        Pushkar Appartment,<br>
        Savedi, Pipeline Road,<br>
        Ahmednagar - 414003
    </p>

    <div class="office-actions">

        <a href="tel:9423390308" class="office-btn">
            Call Office
        </a>

       <a href="https://www.google.com/maps/search/?api=1&query=Flat+No+2+Plot+No+1+Pushkar+Apartment+Savedi+Pipeline+Road+Ahmednagar+414003"
   target="_blank"
   class="office-btn office-map-btn">
   Open In Maps
</a>

    </div>

</div>

        <!-- Navi Mumbai -->

       <div class="office-card">

    <div class="office-icon">
        <i class="fas fa-building"></i>
    </div>

    <h3>Head Office 2</h3>

    <p class="office-address">
        Shop No. 01, Plot No. 97,<br>
        Sector 20, Ulwe Node,<br>
        Navi Mumbai - 410206
    </p>

     <div class="office-actions">

        <a href="tel:9423390308" class="office-btn">
            Call Office
        </a>

       <a href="https://www.google.com/maps/search/?api=1&query=Shop+No+01+Plot+No+97+Sector+20+Ulwe+Node+Navi+Mumbai+410206"
   target="_blank"
   class="office-btn office-map-btn">
   Open In Maps
</a>

</div>

    </div>

</section>

    
     <!-- Google Map Section -->

<section class="map-section">

    <div class="section-title center-title">
        <span>Find Us</span>
        <h2>Our Location</h2>
    </div>

    <div class="map-container">

        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3769.524552520569!2d74.73176508071552!3d19.128502735899247!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bdcba890760327b%3A0x516f1bf685c4e5d1!2sFlat%20no.2%2C%204PHP%2BCM2%20Pushkar%20Appartment%2C%20Plot%20No.%201%2C%20Pipeline%20Rd%2C%20Savedi%2C%20Ahilyanagar%2C%20Maharashtra%20414003!5e0!3m2!1sen!2sin!4v1780869032304!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>

    </div>

</section>

<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <a href="tel:+919420950022"
       class="call-btn">
        <i class="fa-solid fa-phone"></i>
    </a>

</div>

<!-- Dealer Modal -->

<div class="dealer-modal" id="dealerModal">

    <div class="dealer-modal-content">

        <span class="close-modal" id="closeDealerModal">
            &times;
        </span>

        <h2>Dealer Inquiry</h2>

        <form>

            <input type="text"
                   placeholder="Dealer Name"
                   required>

            <input type="text"
                   placeholder="City"
                   required>

            <input type="tel"
                   placeholder="Mobile Number"
                   required>

            <button type="submit">
                Submit Inquiry
            </button>

        </form>

    </div>

</div>

    <%- include('footer') %>

    <script src="/js/contact.js"></script>

</body>
</html>