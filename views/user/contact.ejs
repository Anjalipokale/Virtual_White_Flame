<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <title>Contact Us | Virtual White Flame</title>
    <link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/css/contact.css">
    <link rel="stylesheet" href="/css/web.css">
</head>
<body>

    <%- include('navbar') %>

    <!-- Hero Section -->

<!-- Banner -->
<section class="pro_banner">
    <div class="banner-overlay"></div>

    <div class="banner-content">
        <h1>Contact Us</h1>
    </div>
</section>

   <!-- Quick Contact Cards -->

<section class="quick-contact">

    <div class="contact-card">

    <div class="contact-icon">
        <i class="fas fa-headset"></i>
    </div>

    <h3><%= contact.phone_title %></h3>

    <a href="tel:<%= contact.phone1 %>" class="contact-link">
        <%= contact.phone1 %>
    </a>

    <a href="tel:<%= contact.phone2 %>" class="contact-link">
        <%= contact.phone2 %>
    </a>

</div>

<div class="contact-card">

    <div class="contact-icon">
        <i class="fas fa-envelope"></i>
    </div>

    <h3><%= contact.email_title %></h3>

    <a href="mailto:<%= contact.email1 %>" class="contact-link">
        <%= contact.email1 %>
    </a>

    <a href="mailto:<%= contact.email2 %>" class="contact-link">
        <%= contact.email2 %>
    </a>

</div>

<div class="contact-card">

    <div class="contact-icon">
        <i class="fas fa-map-marker-alt"></i>
    </div>

    <h3><%= contact.office_title %></h3>

    <p><%= contact.office1 %></p>
    <p><%= contact.office2 %></p>

</div>

    <div class="contact-card">

    <div class="contact-icon">
        <i class="fas fa-handshake"></i>
    </div>

   <h3>Dealer Inquiry</h3>

<p>Become a Dealer</p>

<button class="dealer-btn" id="openDealerModal">
    Enquire Now
</button>

</div>

</section>

   
     <!-- Contact Form & Callback -->

<section class="contact-section" id="contact-form">

    <div class="contact-container">

        <!-- Contact Form -->

       <div class="contact-form-box">

    <div class="section-title">
        <span>Send Message</span>
        <h2>Get In Touch With Us</h2>
    </div>

   <form action="/contact-submit" method="POST">


<div class="input-row">

    <input
        type="text"
        name="name"
        placeholder="Full Name"
        pattern="[A-Za-z ]+"
        title="Only letters are allowed"
        required>

    <input
        type="email"
        name="email"
        placeholder="Email Address"
        required>

</div>

<div class="input-row">

    <input
        type="tel"
        name="phone"
        placeholder="Phone Number"
        pattern="[0-9]{10}"
        maxlength="10"
        minlength="10"
        title="Please enter exactly 10 digits"
        required>

    <input
        type="text"
        name="subject"
        placeholder="Subject">

</div>

<textarea
    name="message"
    rows="6"
    placeholder="Write your message here..."
    required>
</textarea>

<button type="submit" class="send-btn">
    Send Message
</button>


</form>

<script>
// Full Name - only letters and spaces
document.querySelector('input[name="name"]').addEventListener('input', function () {
    this.value = this.value.replace(/[^A-Za-z ]/g, '');
});

// Phone - only 10 digits
document.querySelector('input[name="phone"]').addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 10);
});
</script>

</div>

        <!-- Callback Card -->

        <div class="callback-card">

    <div class="callback-icon">
        <i class="fas fa-phone-volume"></i>
    </div>

    <h3>Request A Callback</h3>

    <p>
        Leave your details and our team
        will contact you shortly.
    </p>
<form action="/save-callback" method="POST">

<input
    type="text"
    name="name"
    id="callbackName"
    placeholder="Your Name"
    required>

<input
    type="tel"
    name="mobile"
    id="callbackMobile"
    placeholder="Mobile Number"
    pattern="[0-9]{10}"
    maxlength="10"
    minlength="10"
    title="Please enter exactly 10 digits"
    required>

<input
    type="time"
    name="time"
    required>

<button class="callback-btn" type="submit">
    Request Callback
</button>

</form>

<script>
// Name - only letters and spaces
document.querySelector('input[name="name"]').addEventListener('input', function () {
    this.value = this.value.replace(/[^A-Za-z ]/g, '');
});

// Mobile - only 10 digits
document.querySelector('input[name="mobile"]').addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 10);
});
</script>


</div>

    </div>

</section>

    


    <!-- Office Locations -->

    

<section class="office-section">

    <div class="section-title center-title">
        <span>Regional Contacts</span>
        <h2>Our Office Locations</h2>
    </div>

    <div class="office-grid">

        <!-- Office 1 -->

        <div class="office-card">

            <div class="office-icon">
                <i class="fas fa-location-dot"></i>
            </div>

            <h3>
                <%= office.office1_title %>
            </h3>

            <p class="office-address">
                <%= office.office1_address %>
            </p>

            <div class="office-actions">

                <a href="tel:<%= office.office1_phone %>" 
                   class="office-btn">
                    Call Office
                </a>

                <a href="<%= office.office1_map %>"
                   target="_blank"
                   class="office-btn office-map-btn">
                    Open In Maps
                </a>

            </div>

        </div>


        <!-- Office 2 -->

        <div class="office-card">

            <div class="office-icon">
                <i class="fas fa-building"></i>
            </div>

            <h3>
                <%= office.office2_title %>
            </h3>

            <p class="office-address">
                <%= office.office2_address %>
            </p>

            <div class="office-actions">

                <a href="tel:<%= office.office2_phone %>"
                   class="office-btn">
                    Call Office
                </a>

                <a href="<%= office.office2_map %>"
                   target="_blank"
                   class="office-btn office-map-btn">
                    Open In Maps
                </a>

            </div>

        </div>

    </div>

</section>

    
     <!-- Google Map Section -->

<section class="map-section">

    <div class="section-title center-title">
        <span>Find Us</span>
        <h2>Our Location</h2>
    </div>

    <div class="map-container">

        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3769.524552520569!2d74.73176508071552!3d19.128502735899247!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bdcba890760327b%3A0x516f1bf685c4e5d1!2sFlat%20no.2%2C%204PHP%2BCM2%20Pushkar%20Appartment%2C%20Plot%20No.%201%2C%20Pipeline%20Rd%2C%20Savedi%2C%20Ahilyanagar%2C%20Maharashtra%20414003!5e0!3m2!1sen!2sin!4v1780869032304!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>

    </div>

</section>

<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>

<!-- Dealer Modal -->

<div class="dealer-modal" id="dealerModal">

    <div class="dealer-modal-content">

        <span class="close-modal" id="closeDealerModal">
            &times;
        </span>

        <h2>Dealer Inquiry</h2>

       <form action="/dealer-inquiry" method="POST">


<input type="text"
       name="dealer_name"
       placeholder="Dealer Name"
       pattern="[A-Za-z ]+"
       title="Only letters are allowed"
       required>

<input type="text"
       name="city"
       placeholder="City"
       pattern="[A-Za-z ]+"
       title="Only letters are allowed"
       required>

<input
       type="tel"
       name="mobile"
       placeholder="Mobile Number"
       pattern="[0-9]{10}"
       maxlength="10"
       minlength="10"
       title="Please enter exactly 10 digits"
       required>

<button type="submit">
    Submit Inquiry
</button>


</form>

<script>

// Dealer Name - only letters and spaces
document.querySelector('input[name="dealer_name"]').addEventListener('input', function () {
    this.value = this.value.replace(/[^A-Za-z ]/g, '');
});

// City - only letters and spaces
document.querySelector('input[name="city"]').addEventListener('input', function () {
    this.value = this.value.replace(/[^A-Za-z ]/g, '');
});

// Mobile - only 10 digits
document.querySelector('input[name="mobile"]').addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 10);
});


// Success Popup

window.addEventListener("load", function(){

    const params = new URLSearchParams(window.location.search);

    if(params.get("success")){

        let popup = document.createElement("div");

        popup.innerHTML = "✅ Dealer Inquiry Submitted Successfully";

        popup.style.position = "fixed";
        popup.style.top = "50%";
        popup.style.left = "50%";
        popup.style.transform = "translate(-50%, -50%)";
        popup.style.background = "#198754";
        popup.style.color = "#fff";
        popup.style.padding = "20px 35px";
        popup.style.borderRadius = "12px";
        popup.style.fontSize = "18px";
        popup.style.fontWeight = "600";
        popup.style.textAlign = "center";
        popup.style.boxShadow = "0 5px 20px rgba(0,0,0,0.3)";
        popup.style.zIndex = "9999";

        document.body.appendChild(popup);

        setTimeout(function(){

            popup.remove();

            window.history.replaceState(
                {},
                document.title,
                window.location.pathname
            );

        }, 3000);

    }

});

</script>

    </div>

</div>
    <%- include('footer') %>

    <script src="/js/contact.js"></script>

</body>
</html>