<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blog Detail – VirtualWhiteFlame</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/blogdetails.css">
</head>
<body>

<div class="page-shell">

  <!-- ════════════════════════════════
       LEFT: MAIN BLOG CONTENT
  ════════════════════════════════ -->
  <main class="main-content" id="mainContent">

    <!-- breadcrumb -->
    <nav class="breadcrumb">
      <a href="/blogs">Blogs</a>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      <span id="bcCat">Sustainability</span>
    </nav>

    <!-- meta -->
    <div class="blog-meta">
      <span class="meta-badge" id="metaBadge">Sustainability</span>
      <span class="meta-date"><span class="meta-dot" id="metaDot"></span><span id="metaDate">09 Oct 2024</span></span>
    </div>

    <!-- title -->
    <h1 class="blog-title fade-in" id="blogTitle">Biomass Fuels Over Fossil Fuels</h1>

    <!-- hero image -->
    <img class="blog-hero-img fade-in" id="blogImg" src="" alt="Blog Image">

    <!-- accent -->
    <div class="accent-bar"></div>

    <!-- body -->
    <div class="blog-body fade-in" id="blogBody">
      <p>Loading...</p>
    </div>

    <!-- tags -->
    <div class="tag-row" id="tagRow"></div>

    <!-- prev / next -->
    <div class="blog-nav">
      <button class="nav-btn" id="prevBtn" onclick="navigate(-1)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Previous
      </button>
      <button class="nav-btn" id="nextBtn" onclick="navigate(1)">
        Next
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>

  </main>


  <!-- ════════════════════════════════
       RIGHT: SIDEBAR
  ════════════════════════════════ -->
  <aside class="sidebar">

    <!-- Search -->
    <div class="search-wrap">
      <input type="text" class="search-input" placeholder="Search blogs…" id="searchInput" oninput="handleSearch(this.value)">
      <span class="search-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      </span>
    </div>

    <div class="sidebar-head">
      <span class="sidebar-head-title">All Blogs</span>
      <span class="sidebar-head-line"></span>
    </div>

    <!-- No results -->
    <p class="no-results" id="noResults">No blogs found.</p>

    <!-- ── Sustainability Category ── -->
    <div class="cat-group" id="grp-sustainability">
      <button class="cat-trigger" aria-expanded="true" onclick="toggleCat(this, 'list-sustainability')">
        <span class="cat-dot"></span>
        Sustainability &amp; Environment
        <span class="cat-count" id="cnt-sustainability">1</span>
        <svg class="cat-arrow" viewBox="0 0 24 24" fill="none" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="cat-body open" id="list-sustainability"></div>
    </div>

    <!-- ── Technology Category ── -->
    <div class="cat-group orange" id="grp-technology">
      <button class="cat-trigger" aria-expanded="true" onclick="toggleCat(this, 'list-technology')">
        <span class="cat-dot"></span>
        Technology &amp; Products
        <span class="cat-count" id="cnt-technology">1</span>
        <svg class="cat-arrow" viewBox="0 0 24 24" fill="none" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="cat-body open" id="list-technology"></div>
    </div>

    <!-- ── Agriculture Category ── -->
    <div class="cat-group orange" id="grp-agriculture">
      <button class="cat-trigger" aria-expanded="true" onclick="toggleCat(this, 'list-agriculture')">
        <span class="cat-dot"></span>
        Agriculture &amp; Rural
        <span class="cat-count" id="cnt-agriculture">1</span>
        <svg class="cat-arrow" viewBox="0 0 24 24" fill="none" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="cat-body open" id="list-agriculture"></div>
    </div>

  </aside>
</div>

<script src="/js/blogdetails.js"></script>

<!-- Floating Contact Buttons -->
<div class="floating-buttons">
    <a href="https://wa.me/919423390308" class="whatsapp-btn" target="_blank">
        <i class="fa-brands fa-whatsapp"></i>
    </a>
    <a href="tel:+919420950022" class="call-btn">
        <i class="fa-solid fa-phone"></i>
    </a>
</div>

</body>
</html>