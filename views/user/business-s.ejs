<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="/css/business-s.css">
</head>
<body>
      <%- include('navbar') %>
    
<!-- Business Services Hero Section -->
<section class="business-hero">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>Business Services</h1>
    </div>
</section>


<!-- Business Services Introduction -->
<section class="business-intro">

    <div class="container">

        <div class="section-header">
            <span>Business Solutions</span>

            <h2>
                Streamlining Operations Through Smart Business Services
            </h2>

            <p>
                Our business services are designed to improve customer
                engagement, simplify inquiry management, strengthen vendor
                partnerships, and support sustainable business growth through
                modern digital solutions.
            </p>
        </div>

    </div>

</section>

<section class="business-services-page">
<section class="business-feature" id="business-services">


<div class="container">

    <div class="feature-row reverse">

        <div class="feature-image">
            <img src="/img/lead-management.jpg" alt="Lead Management System">
        </div>

        <div class="feature-content">

            <span class="feature-tag">Business Services</span>

            <h2>Lead Management System</h2>

            <p>
                Our Lead Management System helps businesses capture,
                organize, and track potential customer inquiries through
                a structured workflow. It ensures better follow-up,
                improved communication, and higher conversion opportunities.
            </p>

            <ul class="feature-list">
                <li>Track customer inquiries efficiently</li>
                <li>Improve lead conversion process</li>
                <li>Organized follow-up management</li>
                <li>Better customer engagement</li>
            </ul>

            <a href="/contact" class="feature-btn">Learn More</a>

        </div>

    </div>

</div>


</section>

<section class="business-feature">


<div class="container">

    <div class="feature-row">

        <div class="feature-content">

            <span class="feature-tag">Business Services</span>

            <h2>CRM Integration</h2>

            <p>
                CRM Integration helps businesses manage customer
                interactions, improve communication, and maintain
                organized records for better relationship management.
            </p>

            <ul class="feature-list">
                <li>Centralized customer database</li>
                <li>Improved communication workflow</li>
                <li>Better customer engagement</li>
                <li>Enhanced relationship management</li>
            </ul>

        </div>

        <div class="feature-image">
            <img src="/img/crm-integration.jpg" alt="CRM Integration">
        </div>

    </div>

</div>


</section>

<section class="business-feature">


<div class="container">

    <div class="feature-row reverse">

        <div class="feature-image">
            <img src="/img/product-inquiry.jpg" alt="Product Inquiry System">
        </div>

        <div class="feature-content">

            <span class="feature-tag">Business Services</span>

            <h2>Product Inquiry System</h2>

            <p>
                The Product Inquiry System provides a structured way
                for customers and partners to submit product-related
                requests and receive timely assistance.
            </p>

            <ul class="feature-list">
                <li>Easy inquiry submission</li>
                <li>Quick response process</li>
                <li>Organized communication flow</li>
                <li>Improved customer experience</li>
            </ul>

        </div>

    </div>

</div>


</section>

<section class="business-feature">


<div class="container">

    <div class="feature-row">

        <div class="feature-content">

            <span class="feature-tag">Business Services</span>

            <h2>Download Center</h2>

            <p>
                Access important resources including brochures,
                datasheets, certifications, and business documents
                through a centralized download platform.
            </p>

            <ul class="feature-list">
                <li>Product brochures</li>
                <li>Technical datasheets</li>
                <li>Certificates & documents</li>
                <li>Easy resource access</li>
            </ul>

        </div>

        <div class="feature-image">
            <img src="/img/download-center.jpg" alt="Download Center">
        </div>

    </div>

</div>


</section>

<section class="business-feature">


<div class="container">

    <div class="feature-row reverse">

        <div class="feature-image">
            <img src="/img/vendor-registration.jpg" alt="Vendor Registration">
        </div>

        <div class="feature-content">

            <span class="feature-tag">Business Services</span>

            <h2>Vendor Registration</h2>

            <p>
                Our Vendor Registration platform enables suppliers
                and partners to collaborate efficiently while ensuring
                a streamlined onboarding process.
            </p>

            <ul class="feature-list">
                <li>Simple registration process</li>
                <li>Partnership opportunities</li>
                <li>Efficient onboarding</li>
                <li>Business collaboration support</li>
            </ul>

        </div>

    </div>

</div>


</section>
</section>


<!-- Business Services CTA Section -->
<section class="business-cta">

    <div class="container">

        <h2>Ready to Work With Us?</h2>

        <p>
            Explore our business solutions and discover how Virtual White Flame
            can support your operational and growth objectives.
        </p>

        <a href="/contact" class="cta-btn">
            Contact Our Team
        </a>

    </div>

</section>

<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>



 <%- include('footer') %>
    
</body>
</html>