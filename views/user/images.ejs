<%- include('navbar.ejs') %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery</title>

    <link rel="stylesheet" href="/css/gallery.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>

<section class="banner">

    <div class="banner-text">
        <h1>Gallery</h1>
    </div>

</section>

<section class="gallery-section">

    <div class="filter-buttons">
        <button onclick="filterGallery('all')">Show All</button>
        <button onclick="filterGallery('machinery')">Machineries</button>
        <button onclick="filterGallery('social')">Factory Photos</button>
        <button onclick="filterGallery('product')">Products</button>
    </div>

    <div class="gallery">

<% if(gallery && gallery.length > 0){ %>

    <% gallery.forEach(function(item){ %>

        <div class="gallery-item <%= item.category %>">

            <img src="<%= item.image %>" alt="">

            <div class="overlay">
                <span>➜</span>
            </div>

            <h3><%= item.title %></h3>

        </div>

    <% }) %>

<% } else { %>

    <p>No images found</p>

<% } %>

</div>

</section>

<!-- Lightbox -->

<div id="lightbox" class="lightbox">

    <span class="close" onclick="closeLightbox()">
        &times;
    </span>

    <img id="lightbox-img">

    <a class="prev" onclick="changeImage(-1)">
        ❮
    </a>

    <a class="next" onclick="changeImage(1)">
        ❯
    </a>

</div>

<!-- Floating Buttons -->

<div class="floating-buttons">

    <a href="/products"
       class="product-btn"
       title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022"
       class="call-btn"
       title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>

<script src="/js/script.js"></script>

</body>
</html>

<%- include('footer.ejs') %>