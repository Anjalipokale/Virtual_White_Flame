<%- include("navbar.ejs")%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blogs – VirtualWhiteFlame</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/blog.css">
</head>
<body>

<div class="hero-wrap">
  <img class="hero-img" src="https://virtualwhiteflame.com/uploads/172086857341378070.png" alt="Blog banner">
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-tag">VirtualWhiteFlame · Knowledge Hub</span>
      <h1 class="hero-title">Our <em>Blogs</em></h1>
      <p class="hero-sub">Insights on biomass energy, sustainability &amp; the green future</p>
      <div class="hero-bar"></div>
    </div>
  </section>
</div>
<main class="wrap">
  <div class="filter-row">
    <button class="filter-btn all active" onclick="filter('all',this)"><span class="dot"></span> All Posts</button>
    <button class="filter-btn sus" onclick="filter('sustainability',this)"><span class="dot"></span> Sustainability &amp; Environment</button>
    <button class="filter-btn tech" onclick="filter('technology',this)"><span class="dot"></span> Technology &amp; Products</button>
    <button class="filter-btn agri" onclick="filter('agriculture',this)"><span class="dot"></span> Agriculture &amp; Rural</button>
  </div>

  <div class="cat-block" id="block-all">
    <div class="grid">

      <div class="card" data-cat="sustainability">
        <div class="card-img-wrap"><img src="/img/blogimg1.png" alt="blog image"><span class="card-badge">Sustainability</span></div>
        <div class="card-body"><p class="card-date">09 Oct 2024</p><h3 class="card-title">Biomass Fuels Over Fossil Fuels</h3>
        <a href="/blogdetails?id=1" class="read-btn">Read More <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
      </div>

      <div class="card" data-cat="technology">
        <div class="card-img-wrap"><img src="/img/blogimg7.png" alt="blog image"><span class="card-badge">Technology</span></div>
        <div class="card-body"><p class="card-date">15 Oct 2024</p><h3 class="card-title">The Dual Nature of Biomass Briquettes and Pellets: Benefits and Drawbacks</h3>
        <a href="/blogdetails?id=7" class="read-btn">Read More <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
      </div>

      <div class="card" data-cat="agriculture">
        <div class="card-img-wrap"><img src="/img/blogimg9.png" alt="blog image"><span class="card-badge">Agriculture</span></div>
        <div class="card-body"><p class="card-date">22 Oct 2024</p><h3 class="card-title">The Role of Agricultural Waste in Biomass Briquette Production</h3>
        <a href="/blogdetails?id=9" class="read-btn">Read More <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>
      </div>

    </div>
  </div>
</main>

<script src="/js/blog.js"></script>

<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>
</body>
</html>
<%- include("footer.ejs")%>

