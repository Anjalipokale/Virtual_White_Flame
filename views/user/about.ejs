<%- include("navbar.ejs") %>

  <!-- =========================
     BANNER SECTION
========================= -->

  <section class="about-banner">

    <div class="banner-overlay"></div>

    <div class="banner-content">
    <h1>Company Overview</h1>

    </div>

  </section>


  <!-- =========================
     MODERN COMPANY OVERVIEW
========================= -->

  <section class="about-pro">

    <div class="about-container-pro">

      <!-- LEFT IMAGE -->
      <div class="about-img-pro">

       <img src="/uploads/<%= about_company.company_image %>" alt="Biomass">
        <div class="exp-pro">
          <h2>  <%= about_company.experience_years %>+</h2>
          <p>Years Experience</p>
        </div>

      </div>

      <!-- RIGHT CONTENT -->
      <div class="about-content-pro">

        <span class="tag-pro">ABOUT COMPANY</span>

        <h2>
        
          <%= about_company.tag_line %>
        


        </h2>

        <p class="desc-pro">
           <%= about_company.company_description%>
        </p>

        <!-- CLEAN FEATURE LIST -->
        <div class="feature-pro">

          <div class="feature-item">
            <i class="fa fa-building"></i>
            <div>
              <h4>  <%= about_company.feature1_title %></h4>
              <p>  <%= about_company.feature1_desc %></p>
            </div>
          </div>

          <div class="feature-item">
            <i class="fa fa-user-tie"></i>
            <div>
               <h4>  <%= about_company.feature2_title %></h4>
              <p>  <%= about_company.feature2_desc %></p>
            </div>
          </div>

          <div class="feature-item">
            <i class="fa fa-leaf"></i>
            <div>
               <h4>  <%= about_company.feature3_title %></h4>
              <p>  <%= about_company.feature3_desc %></p>
            </div>
          </div>

          <div class="feature-item">
            <i class="fa fa-industry"></i>
            <div>
               <h4>  <%= about_company.feature4_title %></h4>
              <p>  <%= about_company.feature4_desc %></p>
            </div>
          </div>

          <div class="feature-item">
            <i class="fa fa-cogs"></i>
            <div>
              <h4>  <%= about_company.feature5_title %></h4>
              <p>  <%= about_company.feature5_desc %></p>
            </div>
          </div>

          <div class="feature-item">
            <i class="fa fa-truck"></i>
            <div>
              <h4>  <%= about_company.feature6_title %></h4>
              <p>
                  <%= about_company.feature6_desc %>
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </section>




  <!-- plant-section -->


<section class="plants-section container-fluid py-5">

  <div class="plants-heading text-center mb-5">

    <span>OUR NETWORK</span>

    <h2>Our Manufacturing Plants</h2>

    <p>
      We operate multiple advanced manufacturing plants
      with modern infrastructure and efficient production facilities.
    </p>

  </div>
    <div class="row g-4 px-3 px-md-5">

        <% plants.forEach(function(p){ %>

        <div class="col-lg-4 col-md-6 col-12">

            <div class="plant-card h-100">

                <div class="plant-logo">
                    <img src="/uploads/<%= p.plant_logo %>" alt="">
                </div>

                <div class="plant-content">

                    <h3><%= p.plant_name %></h3>

                    <p>📍 <%= p.plant_address %></p>

                    <h4>📞 <%= p.plant_phone %></h4>

                    <h5>✉ <%= p.plant_email %></h5>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</section>

  <!-- =========================
     COUNTER SECTION
========================= -->
 <section class="counter-section">

        <div class="counter-shape shape1"></div>
        <div class="counter-shape shape2"></div>

        <div class="container">

            <div class="counter-heading">
                <span>Company Achievement</span>
                <h2>Delivering Excellence Across India</h2>
            </div>

            <div class="row g-4">

                <div class="col-lg-3 col-md-6">
                    <div class="counter-box">

                        <div class="counter-icon">
                            <i class="fa fa-briefcase"></i>
                        </div>

                        <h2>
                            <span class="counter" data-target="12">0</span>+
                        </h2>

                        <p>Years Experience</p>

                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="counter-box">

                        <div class="counter-icon">
                            <i class="fa fa-industry"></i>
                        </div>

                        <h2>
                            <span class="counter" data-target="10000">0</span>+
                        </h2>

                        <p>Monthly Production</p>

                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="counter-box">

                        <div class="counter-icon">
                            <i class="fa fa-users"></i>
                        </div>

                        <h2>
                            <span class="counter" data-target="500">0</span>+
                        </h2>

                        <p>Happy Clients</p>

                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="counter-box">

                        <div class="counter-icon">
                            <i class="fa fa-map-marker-alt"></i>
                        </div>

                        <h2>
                            <span class="counter" data-target="10">0</span>+
                        </h2>

                        <p>States Covered</p>

                    </div>
                </div>

            </div>

        </div>

    </section>


  <!-- Working Process Section
      -->


<section class="process-flow-section container-fluid py-5">

    <div class="process-heading text-center mb-5">

        <span>WORKING PROCESS</span>

        <h2>Working Process Of Biomass Briquettes</h2>

    </div>

    <div class="row justify-content-center align-items-center text-center g-3 px-3 px-md-5">

        <!-- STEP 1 -->
        <div class="col-lg-2 col-md-5 col-12">

            <div class="process-flow-box">

                <div class="process-img">
                    <img src="/img/framers.webp" class="img-fluid" alt="">
                </div>

                <h3>Farmers</h3>

            </div>

        </div>

        <!-- ARROW -->
        <div class="col-lg-1 d-none d-lg-flex justify-content-center">
            <div class="flow-arrow">➜</div>
        </div>

        <!-- STEP 2 -->
        <div class="col-lg-2 col-md-5 col-12">

            <div class="process-flow-box">

                <div class="process-img">
                    <img src="/img/Local-Agents.webp" class="img-fluid" alt="">
                </div>

                <h3>Local Agents</h3>

            </div>

        </div>

        <!-- ARROW -->
        <div class="col-lg-1 d-none d-lg-flex justify-content-center">
            <div class="flow-arrow">➜</div>
        </div>

        <!-- STEP 3 -->
        <div class="col-lg-2 col-md-5 col-12">

            <div class="process-flow-box">

                <div class="process-img">
                    <img src="/img/Briquettes-Pelletes.webp" class="img-fluid" alt="">
                </div>

                <h3>Briquettes & Pellets Manufacturing</h3>

            </div>

        </div>

        <!-- ARROW -->
        <div class="col-lg-1 d-none d-lg-flex justify-content-center">
            <div class="flow-arrow">➜</div>
        </div>

        <!-- STEP 4 -->
        <div class="col-lg-2 col-md-5 col-12">

            <div class="process-flow-box">

                <div class="process-img">
                    <img src="/img/Boiler-Industries.webp" class="img-fluid" alt="">
                </div>

                <h3>Boiler Industries</h3>

            </div>

        </div>

    </div>

</section>

  <!-- infrastructure -->

<section class="infra-grid-section container-fluid py-5">

    <div class="infra-heading text-center mb-5">
        <span>OUR FACILITIES</span>
        <h2>Industrial Infrastructure</h2>
    </div>

    <div class="row g-4 px-3 px-md-5">

        <% infrastructure.forEach(function(i){ %>

        <div class="col-lg-4 col-md-6 col-12">

            <div class="infra-card h-100">

                <img src="/uploads/<%= i.infra_image %>"
                     class="img-fluid"
                     alt="<%= i.infra_title %>">

                <div class="infra-content">

                    <h3><%= i.infra_title %></h3>

                    <p>
                        <%= i.infra_description %>
                    </p>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</section>




