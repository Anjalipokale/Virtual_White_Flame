   <section class="history-page-banner container-fluid p-0">

    <div class="history-banner-overlay"></div>

    <div class="container">

        <div class="row justify-content-center align-items-center text-center">

            <div class="col-12 history-banner-content">

                <h1>Company History</h1>

                <div class="history-breadcrumb d-flex justify-content-center gap-2">
