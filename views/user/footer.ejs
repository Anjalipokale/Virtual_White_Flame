<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VirtualWhiteFlame Footer</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<body>

  <footer class="footer">

    <!-- BRAND STRIP -->
    <div class="footer-brand-strip">
      <div class="strip-inner">
        <div class="brand-block">
          <!-- Place Vlogo.png in same folder -->
          <img src="/img/Vlogo.png" alt="VWF Logo"
            onerror="this.style.display='none';this.nextElementSibling.style.display='block';" class="Vlogo-imgfooter">
          <p class="brand-desc">
            Pioneering sustainable biomass energy solutions across India. From supply management to plant operations —
            powering a greener tomorrow.
          </p>
          <div class="newsletter-wrap">
            <div class="newsletter-label"><i class="fa fa-paper-plane" style="margin-right:5px"></i>Stay Updated</div>
            <div class="newsletter-form">
              <input type="email" placeholder="Your email address" />
              <button>Subscribe</button>
            </div>
          </div>
        </div>
      </div>

      <div class="footer-divider"></div>

      <!-- MAIN GRID -->
      <div class="footer-grid">

        <!-- Col 1: Contact Us -->
        <div class="footer-col">
          <h4 class="col-title">Contact Us</h4>

          <div class="contact-item">
            <span class="ci-icon"><i class="fa fa-phone"></i></span>
            <div>
              <a href="tel:9423390308">9423390308</a><br>
              <a href="tel:9420950022">9420950022</a>
            </div>
          </div>

          <div class="contact-item">
            <span class="ci-icon"><i class="fa fa-envelope"></i></span>
            <div>
              <a href="mailto:sales@virtualwhiteflame.com">sales@virtualwhiteflame.com</a>
            </div>
          </div>

          <div class="contact-item">
            <span class="ci-icon"><i class="fa fa-clock"></i></span>
            <div>Mon – Sat: 9:00 AM – 6:00 PM<br><span style="font-size:12px;opacity:.7">Sun: Closed</span></div>
          </div>
        </div>

        <!-- Col 2: About Us -->
        <div class="footer-col">
          <h4 class="col-title">About Us</h4>
          <ul class="footer-links">
            <li><a href="/vision-mission">Vision &amp; Mission</a></li>
            <li><a href="/company-history">Company History</a></li>
            <li><a href="/career">FAQ'S</a></li>
            <li><a href="/blog">Blogs</a></li>
            <li><a href="/support_services">Feedback</a></li>
            <li><a href="#">Terms &amp; Condition</a></li>
            <li><a href="#">Privacy &amp; Policy</a></li>
          </ul>
        </div>

        <!-- Col 3: Get In Touch -->
        <div class="footer-col">
          <h4 class="col-title">Get In Touch</h4>

          <div class="address-card">
            <div class="addr-label"><i class="fa fa-location-dot"></i>Registered Office</div>
            <div class="addr-text">
              <strong>Flat no. 2, Plot No. 1, Pushkar Appartment,</strong><br>
              Savedi, Pipeline Road,<br>
              Ahmednagar – 414003
            </div>
          </div>

          <a href="mailto:operation.virtualwhiteflame@gmail.com" class="mail-link">
            <i class="fa fa-envelope"></i>
            operation.virtualwhiteflame@gmail.com
          </a>
        </div>

        <!-- Col 4: Quick Link + Social -->
        <div class="footer-col">
          <h4 class="col-title">Quick Link</h4>
          <ul class="quick-links">
            <li><a href="/"><i class="fa fa-home"></i>Home</a></li>
            <li><a href="/products"><i class="fa fa-box"></i>Products</a></li>
            <li><a href="/plants"><i class="fa fa-leaf"></i>Plants</a></li>
            <li><a href="/gallery"><i class="fa fa-images"></i>Gallery</a></li>
            <li><a href="/career"><i class="fa fa-briefcase"></i>Career</a></li>
            <li><a href="/contact"><i class="fa fa-headset"></i>Contact Us</a></li>
          </ul>

          <div class="social-section">
            <div class="social-label">Follow Us</div>
            <div class="social-row">
              <a href="https://www.facebook.com/" class="social-btn fb" title="Facebook"><i class="fab fa-facebook-f"></i></a>
              <a href="https://www.instagram.com/" class="social-btn ig" title="Instagram"><i class="fab fa-instagram"></i></a>
              <a href="https://www.linkedin.com/" class="social-btn li" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
              <a href="https://www.youtube.com/" class="social-btn yt" title="YouTube"><i class="fab fa-youtube"></i></a>
            </div>
          </div>
        </div>

      </div>

      <!-- BOTTOM BAR -->
      <div class="footer-bottom">
        <div class="bottom-inner">
          <p class="copyright">
            &copy; Copyright 2026 &nbsp;
            <a href="#">Virtual White Flame PVT.LTD.</a>
            &nbsp; All rights reserved.
          </p>
          <div class="bottom-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms &amp; Conditions</a>
            <a href="#">Sitemap</a>
          </div>
          <div class="bottom-badge">
            <span></span> Active &amp; Operational
          </div>
        </div>
      </div>

  </footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>