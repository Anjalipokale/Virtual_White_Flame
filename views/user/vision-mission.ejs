<%- include("navbar.ejs")%>


    </head>

    <body>

        <!-- =========================
     BANNER
========================= -->

        <section class="vm-banner">

            <div class="vm-banner-content">
                <h1>VISION & MISSION</h1>
            </div>

        </section>






        <!-- VISION & MISSION SECTION -->

 <section class="vision-mission-section container-fluid">

    <div class="row justify-content-center g-4 px-3 px-md-5">

        <% vision.forEach(function(v){ %>

        <div class="col-lg-5 col-md-6">

            <div class="vm-box h-100">

                <div class="vm-icon">
                    <i class="fa-solid fa-eye"></i>
                </div>

                <h2>
                    <%= v.vision_title %>
                </h2>

                <p>
                    <%= v.vision_description %>
                </p>

            </div>

        </div>

        <% }) %>

    </div>

</section>
        <!-- =========================
     GREEN ENERGY
========================= -->

      <section class="green-section container-fluid">

    <div class="row align-items-center g-5 px-3 px-md-5">

        <!-- LEFT IMAGE -->
        <div class="col-lg-6">

            <div class="green-left position-relative">

                <img src="/img/sustainability.jpg" class="img-fluid w-100">

                <div class="green-badge">
                    <h3>100%</h3>
                    <p>Eco-Friendly Fuel</p>
                </div>

            </div>

        </div>


        <!-- RIGHT CONTENT -->
        <div class="col-lg-6">

            <div class="green-right">

                <span class="green-tag">SUSTAINABILITY</span>

                <h2>
                    Driving India Towards <br>
                    Clean & Green Biomass Energy
                </h2>

                <p>
                    We are a trusted Biomass Briquettes and Biomass Pellets
                    manufacturer & supplier covering major industrial regions
                    across India. Our mission is to provide renewable fuel
                    solutions that help industries reduce carbon emissions
                    and dependency on conventional fossil fuels.
                </p>

                <p>
                    Through advanced manufacturing processes and responsible
                    resource management, we transform agricultural waste into
                    high-quality biomass fuel that supports a cleaner,
                    greener and more sustainable future.
                </p>


                <!-- FEATURES -->
                <div class="green-features">

                    <div class="green-feature-box">
                        <i class="fa-solid fa-leaf"></i>
                        <div>
                            <h4>Eco-Friendly Production</h4>
                            <p>Low carbon emission manufacturing process.</p>
                        </div>
                    </div>

                    <div class="green-feature-box">
                        <i class="fa-solid fa-industry"></i>
                        <div>
                            <h4>Industrial Fuel Solution</h4>
                            <p>Reliable biomass fuel for boiler industries.</p>
                        </div>
                    </div>

                    <div class="green-feature-box">
                        <i class="fa-solid fa-recycle"></i>
                        <div>
                            <h4>Waste to Energy</h4>
                            <p>Converting agricultural waste into green energy.</p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



        
<!-- Sustainability Dashboard -->

     <section class="sustainability-dashboard container-fluid">

    <div class="container">

        <div class="text-center section-heading">

            <span>SUSTAINABILITY DASHBOARD</span>

            <h2>Powering Industries with
             Sustainable Biomass Energy</h2>

            <p>
                Every biomass briquette and pellet contributes towards reducing
                carbon emissions and promoting sustainable energy solutions.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="sustain-card">
                    <div class="sustain-icon">🌍</div>
                    <h3>25,000+</h3>
                    <h5>CO₂ Saved</h5>
                    <p>Tons of carbon emissions reduced annually.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="sustain-card">
                    <div class="sustain-icon">🌳</div>
                    <h3>1,50,000+</h3>
                    <h5>Trees Equivalent</h5>
                    <p>Equivalent environmental impact generated.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="sustain-card">
                    <div class="sustain-icon">♻️</div>
                    <h3>80,000+</h3>
                    <h5>Waste Recycled</h5>
                    <p>Agricultural waste converted into clean fuel.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="sustain-card">
                    <div class="sustain-icon">📈</div>
                    <h3>100%</h3>
                    <h5>Green Impact</h5>
                    <p>Committed to sustainable energy solutions.</p>
                </div>
            </div>

        </div>

    </div>

</section>


        <!-- =========================
     FUTURE PLANS
========================= -->

      <section class="future-section container-fluid">

    <div class="row text-center">

        <!-- HEADING -->
        <div class="col-12 future-heading">

            <span>FUTURE GOALS</span>

            <h2>Future Expansion Plans</h2>

        </div>

        <!-- BOX 1 -->
        <% future_goals.forEach(function(f){ %>

        <!-- BOX -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="future-box h-100 p-3 shadow">

                <h3><%= f.goal_title %></h3>

                <p><%= f.goal_description %></p>

            </div>
        </div>

        <% }) %>
     

    </div>

</section>

<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>
    </body>

    </html>
    <%- include("footer.ejs")%>