<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Career - Virtual White Flame</title>

    <!-- Career CSS -->
    <link rel="stylesheet" href="/css/career.css">
    <link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <%- include('navbar') %>

  <!-- Career Banner Start -->

<section class="career-banner">

    <div class="career-banner-content">

        <h1>Career Opportunities</h1>

        <div class="career-breadcrumb">
            <a href="/">Home</a>
            <span> > </span>
            <span>Career</span>
        </div>

    </div>

</section>


<!-- Why Join Us Section Start -->

<section class="why-join-section">

    <div class="why-join-wrapper">

        <!-- Left Image -->

        <div class="why-join-image">
            <img src="/img/why-join.jpg" alt="Why Join Virtual White Flame">
        </div>

        <!-- Right Content -->

        <div class="why-join-content">

            <h2>Why Join Virtual White Flame?</h2>

            <p>
                Join a growing biomass energy company where innovation,
                sustainability and professional growth come together.
            </p>

            <ul class="join-list">

                <li>✔ Career Growth Opportunities</li>

                <li>✔ Sustainable & Green Industry</li>

                <li>✔ Learning & Development Programs</li>

                <li>✔ Supportive Work Environment</li>

                <li>✔ Innovation & Technology Exposure</li>

                <li>✔ Recognition & Career Advancement</li>

            </ul>

        </div>

    </div>

</section>

<!-- Life At Company Section Start -->

<section class="life-company-section">

    <div class="section-title">
    <span class="title-tag">OUR CULTURE</span>
    <h2>Life at Virtual White Flame</h2>
    <p>
        Discover a workplace where teamwork, innovation and growth
        create opportunities for every individual.
    </p>
</div>

    <div class="life-gallery">

        <div class="gallery-card">
            <img src="/img/life1.jpg" alt="Team Culture">
            <h3>Team Collaboration</h3>
        </div>

        <div class="gallery-card">
            <img src="/img/life2.jpg" alt="Plant Operations">
            <h3>Hands-on Industry Experience</h3>
        </div>

        <div class="gallery-card">
            <img src="/img/life3.jpg" alt="Training">
            <h3>Learning & Development</h3>
        </div>

    </div>

</section>

<!-- Open Positions Section Start -->

<section class="jobs-section">

    <div class="section-title">
        <span class="title-tag">CAREER OPPORTUNITIES</span>
        <h2>Current Open Positions</h2>
        <p>
            Explore exciting opportunities and become a part of our growing team.
        </p>
    </div>

    <!-- Department Filter -->

    <div class="job-filter">

        <button class="filter-btn active" data-filter="All">All</button>

        <button class="filter-btn" data-filter="Sales">Sales</button>

        <button class="filter-btn" data-filter="Marketing">Marketing</button>

        <button class="filter-btn" data-filter="Production">Production</button>

        <button class="filter-btn" data-filter="HR">HR</button>

        <button class="filter-btn" data-filter="Accounts">Accounts</button>

    </div>

    <!-- Job Cards -->

    <div class="jobs-container">

       <div class="job-card" data-department="Sales">
            <h3>Sales Executive</h3>
            <p><strong>Department:</strong> Sales</p>
            <p><strong>Experience:</strong> 1-2 Years</p>
            <p><strong>Location:</strong> Pune</p>
            <button class="apply-btn open-modal" data-job="Sales Executive">
    Apply Now
</button>
        </div>

       <div class="job-card" data-department="Marketing">
            <h3>Marketing Manager</h3>
            <p><strong>Department:</strong> Marketing</p>
            <p><strong>Experience:</strong> 3-5 Years</p>
            <p><strong>Location:</strong> Pune</p>
            <button class="apply-btn open-modal" data-job="Marketing Manager">
    Apply Now
</button>
        </div>

        <div class="job-card" data-department="Production">
            <h3>Production Supervisor</h3>
            <p><strong>Department:</strong> Production</p>
            <p><strong>Experience:</strong> 2-4 Years</p>
            <p><strong>Location:</strong> Plant Site</p>
            <button class="apply-btn open-modal" data-job="Production Supervisor">
    Apply Now
</button>
        </div>

        <div class="job-card" data-department="Production">
            <h3>Plant Operator</h3>
            <p><strong>Department:</strong> Production</p>
            <p><strong>Experience:</strong> 1-3 Years</p>
            <p><strong>Location:</strong> Plant Site</p>
            <button class="apply-btn open-modal" data-job="Plant Operator">
    Apply Now
</button>
        </div>

       <div class="job-card" data-department="Accounts">
            <h3>Accountant</h3>
            <p><strong>Department:</strong> Accounts</p>
            <p><strong>Experience:</strong> 2-3 Years</p>
            <p><strong>Location:</strong> Pune</p>
            <button class="apply-btn open-modal" data-job="Accountant">
    Apply Now
</button>
        </div>

        <div class="job-card" data-department="HR">
            <h3>HR Executive</h3>
            <p><strong>Department:</strong> HR</p>
            <p><strong>Experience:</strong> 1-2 Years</p>
            <p><strong>Location:</strong> Pune</p>
            <button class="apply-btn open-modal" data-job="HR Executive">
    Apply Now
</button>
        </div>

    </div>

</section>


<!-- Apply Form Modal Start -->

<div class="job-modal" id="jobModal">

    <div class="modal-content">

        <span class="close-modal">&times;</span>

        <h2>Apply for Position</h2>

        <form>

            <div class="form-group">
                <input type="text" placeholder="Full Name" required>
            </div>

            <div class="form-group">
                <input type="email" placeholder="Email Address" required>
            </div>

            <div class="form-group">
                <input type="tel" placeholder="Mobile Number" required>
            </div>

            <div class="form-group">

                <select id="jobPosition" required>

                    <option value="">Select Position</option>

                    <option>Sales Executive</option>
                    <option>Marketing Manager</option>
                    <option>Production Supervisor</option>
                    <option>Plant Operator</option>
                    <option>Accountant</option>
                    <option>HR Executive</option>

                </select>

            </div>

            <div class="form-group">

                <label>Upload Resume</label>

                <input type="file" accept=".pdf,.doc,.docx">

                <small>Accepted Formats: PDF, DOC, DOCX</small>

            </div>

            <button type="submit" class="submit-btn">
                Submit Application
            </button>

        </form>

    </div>

</div>

<!-- Application Tracking Section Start -->

<section class="tracking-section">

    <div class="section-title">
        <span class="title-tag">APPLICATION STATUS</span>
        <h2>Track Your Application</h2>
        <p>
            Enter your Application ID to check the current recruitment status.
        </p>
    </div>

    <!-- Tracking Search -->

    <div class="tracking-search">

        <input
            type="text"
            placeholder="Enter Application ID (Example: VWF2026001)"
        >

        <button class="track-btn">
            Track Status
        </button>

    </div>

   <!-- Tracking Result Card -->

<div class="tracking-card">

    <div class="tracking-header">

        <h3>Application ID : VWF2026001</h3>

        <span class="status-badge">
            Interview Scheduled
        </span>

    </div>

    <div class="progress-section">

        <div class="progress-info">

            <span>Application Progress</span>

            <span>75%</span>

        </div>

        <div class="progress-bar">

            <div class="progress-fill"></div>

        </div>

    </div>

    <div class="status-list">

        <div class="status-item completed">
            ✓ Applied
        </div>

        <div class="status-item completed">
            ✓ Under Review
        </div>

        <div class="status-item completed">
            ✓ Shortlisted
        </div>

        <div class="status-item active">
            ● Interview Scheduled
        </div>

        <div class="status-item">
            ○ Selected
        </div>

    </div>

</div>

</section>

<!-- FAQ Section Start -->

<section class="faq-section">

    <div class="section-title">
        <span class="title-tag">FAQ</span>
        <h2>Frequently Asked Questions</h2>
        <p>
            Find answers to common questions about careers at Virtual White Flame.
        </p>
    </div>

    <div class="faq-container">

        <div class="faq-item">
            <button class="faq-question">
                How can I apply for a job?
            </button>
            <div class="faq-answer">
                Submit your application using the Apply Now form available on the Career page.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                What file formats are accepted for resume upload?
            </button>
            <div class="faq-answer">
                We accept PDF, DOC and DOCX file formats.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                How can I track my application status?
            </button>
            <div class="faq-answer">
                Enter your Application ID in the Application Tracking section.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                Will I receive an interview call after applying?
            </button>
            <div class="faq-answer">
                Shortlisted candidates will be contacted by our HR team.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                Can freshers apply for open positions?
            </button>
            <div class="faq-answer">
                Yes, freshers can apply for suitable entry-level opportunities.
            </div>
        </div>

    </div>

</section>

<!-- HR Contact Section Start -->

<section class="hr-contact-section">

    <div class="section-title">
        <span class="title-tag">NEED HELP?</span>
        <h2>Contact Our HR Team</h2>
        <p>
            Have questions about careers or recruitment? Our HR team is here to help.
        </p>
    </div>

   <div class="hr-contact-card">
      <div class="contact-item">
            <h3>Email</h3>
            <p>sales@virtualwhiteflame.com</p>
        </div>

        <div class="hr-contact-item">
            <h3>Phone</h3>
            <p>+91 9423390308</p>
        </div>

        <div class="hr-contact-item">
            <h3>Working Hours</h3>
            <p>Monday - Saturday | 9:00 AM - 6:00 PM</p>
        </div>

    </div>

</section>

<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>




   <%- include('footer') %>

<script src="/js/career.js"></script>

</body>
</html>