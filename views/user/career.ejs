<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Career - Virtual White Flame</title>

    <!-- Career CSS -->
    <link rel="stylesheet" href="/css/career.css">
    <link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <%- include('navbar') %>

  <!-- Career Banner Start -->

<section class="career-banner">

    <div class="career-banner-content">

        <h1>Career Opportunities</h1>

    </div>

</section>


<!-- Why Join Us Section Start -->

<section class="why-join-section">

    <div class="why-join-wrapper">

        <div class="why-join-image">

            <img src="/uploads/<%= whyJoin.image %>"
                 alt="<%= whyJoin.title %>">

        </div>

        <div class="why-join-content">

            <h2>
                <%= whyJoin.title %>
            </h2>

            <p>
                <%= whyJoin.description %>
            </p>

            <ul class="join-list">

                <li>✔ <%= whyJoin.feature1 %></li>

                <li>✔ <%= whyJoin.feature2 %></li>

                <li>✔ <%= whyJoin.feature3 %></li>

                <li>✔ <%= whyJoin.feature4 %></li>

                <li>✔ <%= whyJoin.feature5 %></li>

                <li>✔ <%= whyJoin.feature6 %></li>

            </ul>

        </div>

    </div>

</section>
<!-- Life At Company Section Start -->

<section class="life-company-section">

    <div class="section-title">
    <span class="title-tag">OUR CULTURE</span>
    <h2>Life at Virtual White Flame</h2>
    <p>
        Discover a workplace where teamwork, innovation and growth
        create opportunities for every individual.
    </p>
</div>

   <div class="life-gallery">

        <% if(culture.length > 0){ %>

            <% culture.forEach(function(c){ %>

                <div class="gallery-card">
                    <img src="<%= c.image %>" alt="<%= c.title %>">
                    <h3><%= c.title %></h3>
                </div>

            <% }) %>

        <% } else { %>

            <p>No Culture Data Found</p>

        <% } %>

    </div>
</section>

<!-- Open Positions Section Start -->

<section class="jobs-section">

    <div class="section-title">
        <span class="title-tag">CAREER OPPORTUNITIES</span>
        <h2>Current Open Positions</h2>
        <p>
            Explore exciting opportunities and become a part of our growing team.
        </p>
    </div>

    <!-- Department Filter -->

    <div class="job-filter">

        <button class="filter-btn active" data-filter="All">All</button>

        <button class="filter-btn" data-filter="Sales">Sales</button>

        <button class="filter-btn" data-filter="Marketing">Marketing</button>

        <button class="filter-btn" data-filter="Production">Production</button>

        <button class="filter-btn" data-filter="HR">HR</button>

        <button class="filter-btn" data-filter="Accounts">Accounts</button>

    </div>

    <!-- Job Cards -->

    <div class="jobs-container">

<% careers.forEach(function(job){ %>

<div class="job-card" data-department="<%= job.department %>">

    <h3><%= job.job_title %></h3>

    <p><b>Department:</b> <%= job.department %></p>
    <p><b>Experience:</b> <%= job.experience %></p>
    <p><b>Location:</b> <%= job.location %></p>

    <button class="apply-btn open-modal"
            data-job="<%= job.job_title %>">
        Apply Now
    </button>

</div>

<% }) %>

</div>
</section>


<!-- Apply Form Modal Start --> 
 
<div class="job-modal" id="jobModal">
 
    <div class="modal-content">

        <span class="close-modal">&times;</span>

        <h2>Apply for Position</h2>
<form action="/save-application" method="post" enctype="multipart/form-data">

<div class="form-group">
    <input type="text" name="name" placeholder="Full Name" required>
</div>

<div class="form-group">
    <input type="email" name="email" placeholder="Email Address" required>
</div>

<div class="form-group">
    <input type="tel" name="mobile" placeholder="Mobile Number" required>
</div>

<div class="form-group">

<select name="position" required>
    <option value="">Select Position</option>
    <option>Sales Executive</option>
    <option>Marketing Manager</option>
    <option>Production Supervisor</option>
    <option>Plant Operator</option>
    <option>Accountant</option>
    <option>HR Executive</option>
</select>

</div>

<div class="form-group">

<label>Upload Resume</label>

<input type="file" name="resume" accept=".pdf,.doc,.docx" required>

</div>

<button type="submit" class="submit-btn">
    Submit Application
</button>

</form>

    </div>
    
</div>

<!-- Application Tracking Section Start -->

<section class="tracking-section">

    <div class="section-title">
        <span class="title-tag">APPLICATION STATUS</span>
        <h2>Track Your Application</h2>
        <p>
            Enter your Application ID to check the current recruitment status.
        </p>
    </div>

    <!-- Tracking Search -->

    <div class="tracking-search">

    <form action="/track-application" method="GET">

        <input
            type="text"
            name="application_id"
            placeholder="Enter Application ID (Example: VWF2026001)"
            required
        >

        <button type="submit" class="track-btn">
            Track Status
        </button>

    </form>

</div>

   <!-- Tracking Result Card -->

<% if(trackingId){ %>

<div style="background:#e8f5e9;padding:20px;margin-top:20px;border-radius:10px;text-align:center;">

    <h3>Application Submitted Successfully</h3>

    <h2>Your Tracking ID:</h2>

    <h1 style="color:green;">
        <%= trackingId %>
    </h1>

    <p>Please save this ID for tracking your application.</p>

</div>

<% } %>

<% if(application){ %>

<div class="tracking-card">

    <div class="tracking-header">

        <h3>
            Application ID :
            <%= application.application_id %>
        </h3>

        <span class="status-badge">
            <%= application.status %>
        </span>

    </div>

    <div class="status-list">

        <div class="status-item <%= application.status=='Applied' || application.status=='Under Review' || application.status=='Shortlisted' || application.status=='Interview Scheduled' || application.status=='Selected' ? 'completed':'' %>">
            ✓ Applied
        </div>

        <div class="status-item <%= application.status=='Under Review' || application.status=='Shortlisted' || application.status=='Interview Scheduled' || application.status=='Selected' ? 'completed':'' %>">
            ✓ Under Review
        </div>

        <div class="status-item <%= application.status=='Shortlisted' || application.status=='Interview Scheduled' || application.status=='Selected' ? 'completed':'' %>">
            ✓ Shortlisted
        </div>

        <div class="status-item <%= application.status=='Interview Scheduled' || application.status=='Selected' ? 'completed':'' %>">
            ✓ Interview Scheduled
        </div>

        <div class="status-item <%= application.status=='Selected' ? 'completed':'' %>">
            ✓ Selected
        </div>

    </div>

</div>

<% } %>
</section>
<!-- FAQ Section Start -->

<section class="faq-section">

    <div class="section-title">
        <span class="title-tag">FAQ</span>
        <h2>Frequently Asked Questions</h2>
        <p>
            Find answers to common questions about careers at Virtual White Flame.
        </p>
    </div>

    <div class="faq-container">

        <div class="faq-item">
            <button class="faq-question">
                How can I apply for a job?
            </button>
            <div class="faq-answer">
                Submit your application using the Apply Now form available on the Career page.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                What file formats are accepted for resume upload?
            </button>
            <div class="faq-answer">
                We accept PDF, DOC and DOCX file formats.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                How can I track my application status?
            </button>
            <div class="faq-answer">
                Enter your Application ID in the Application Tracking section.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                Will I receive an interview call after applying?
            </button>
            <div class="faq-answer">
                Shortlisted candidates will be contacted by our HR team.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question">
                Can freshers apply for open positions?
            </button>
            <div class="faq-answer">
                Yes, freshers can apply for suitable entry-level opportunities.
            </div>
        </div>

    </div>

</section>

<section class="hr-contact-section">

    <div class="section-title">
        <span class="title-tag">NEED HELP?</span>
        <h2>Contact Our HR Team</h2>
        <p>Have questions about careers or recruitment? Our HR team is here to help.</p>
    </div>

   <div class="hr-contact-grid">

    <!-- Phone Card -->
    <div class="hr-card">
        <div class="hr-icon">
            <i class="fas fa-phone-alt"></i>
        </div>

        <h3><%= hrContact.phone_title %></h3>

        <p><%= hrContact.phone1 %></p>
        <p><%= hrContact.phone2 %></p>
    </div>

    <!-- Email Card -->
    <div class="hr-card active">
        <div class="hr-icon">
            <i class="fas fa-envelope"></i>
        </div>

        <h3><%= hrContact.email_title %></h3>

        <p><%= hrContact.email1 %></p>
        <p><%= hrContact.email2 %></p>
    </div>

    <!-- Working Hours Card -->
    <div class="hr-card">
        <div class="hr-icon">
            <i class="fas fa-clock"></i>
        </div>

        <h3><%= hrContact.hours_title %></h3>

        <p><%= hrContact.working_days %></p>
        <p><%= hrContact.working_time %></p>
    </div>

</div>
</section>


<!-- Floating Contact Buttons -->

<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>

<script>
window.addEventListener("load", function() {

    var section = document.getElementById("tracking-section");

    if(section){
        section.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }

});
</script>


   <%- include('footer') %>

<script src="/js/career.js"></script>


</body>
</html>