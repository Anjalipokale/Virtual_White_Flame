<style>

body{
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
    background:#f4f6f9;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
}

.forgot-box{
    width:400px;
    background:#fff;
    padding:35px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.1);
    border-top:5px solid #198754;
}

.forgot-box h2{
    text-align:center;
    color:#ff8800;
    margin-bottom:10px;
}

.forgot-box p{
    text-align:center;
    color:#666;
    margin-bottom:25px;
}

.forgot-box input{
    width:100%;
    padding:12px;
    border:1px solid #ddd;
    border-radius:8px;
    margin-bottom:20px;
    font-size:15px;
    box-sizing:border-box;
}

.forgot-box input:focus{
    outline:none;
    border-color:#198754;
    box-shadow:0 0 5px rgba(25,135,84,.3);
}

.verify-btn{
    width:100%;
    padding:12px;
    border:none;
    border-radius:8px;
    background:linear-gradient(135deg,#198754,#ff8800);
    color:white;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

.verify-btn:hover{
    transform:translateY(-2px);
}

</style>

<div class="forgot-box">

    <h2>Forgot Password</h2>

    <p>Enter your registered email address</p>

    <form action="/forgot-password" method="post">

        <input
            type="email"
            name="email"
            placeholder="Enter Registered Email"
            required>

        <button type="submit" class="verify-btn">
            Verify Email
        </button>

    </form>

</div>