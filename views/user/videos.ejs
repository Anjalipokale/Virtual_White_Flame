<%- include('navbar.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/gallery.css">
</head>
<body>
      
 <section class="bannerv">
 <div class="banner-text">
        <h1>Videos</h1>
    </div>
</section>

 <section class="videos-section">

    <div class="filter-buttons1">
        <button onclick="filterGallery1('all')">Show All</button>
        <button onclick="filterGallery1('plant')">Plant Videos</button>
        <button onclick="filterGallery1('company')">Company Videos</button>
    </div>

    <div class="videos">

        <% if(videos.length > 0){ %>

            <% videos.forEach(function(v){ %>

                <div class="videos-item <%= v.category %>">

                    <video controls>
                        <source src="<%= v.video %>" type="video/mp4">
                        Your browser does not support video.
                    </video>

                </div>

            <% }) %>

        <% } else { %>

            <h3>No Videos Found</h3>

        <% } %>

    </div>

    <!-- floating buttons -->
<div class="floating-buttons">

    <a href="/products" class="product-btn" title="Our Products">
        <i class="fa-solid fa-box"></i>
    </a>

    <a href="tel:+919420950022" class="call-btn" title="Call Us">
        <i class="fa-solid fa-phone"></i>
    </a>

    <a href="https://wa.me/919423390308"
       class="whatsapp-btn"
       target="_blank"
       title="WhatsApp Us">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

</div>
</section>
<script src="script.js"></script>
</body>
</html>

<%- include('footer.ejs') %>