<%- include("navbar.ejs") %>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
<link rel="stylesheet" href="/css/product.css">
<link rel="stylesheet" href="/js/script.js">

<!-- Product Inquiry Popup -->
<div id="inquiryModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeInquiry()">&times;</span>

        <h2>Product Inquiry</h2>

  <form action="/save-inquiry" method="post">


<input type="text" id="productName" name="product_name">

<!-- Name -->
<input
    type="text"
    name="name"
    placeholder="Your Name"
    pattern="[A-Za-z ]+"
    title="Only letters are allowed"
    required
>

<!-- Email -->
<input
    type="email"
    name="email"
    placeholder="Your Email"
    required
>

<!-- Mobile -->
<input
    type="tel"
    name="mobile"
    placeholder="Your Mobile Number"
    pattern="[0-9]{10}"
    maxlength="10"
    minlength="10"
    title="Enter exactly 10 digits"
    required
>

<!-- Message -->
<textarea
    name="message"
    placeholder="Your Inquiry"
    rows="4"
    required
></textarea>

<button type="submit">Submit Inquiry</button>


</form>

<script>
// Name field - only letters and spaces
document.querySelector('input[name="name"]').addEventListener('input', function() {
    this.value = this.value.replace(/[^A-Za-z ]/g, '');
});

// Mobile field - only 10 digits
document.querySelector('input[name="mobile"]').addEventListener('input', function() {
    this.value = this.value.replace(/\D/g, '').slice(0, 10);
});
</script>


    </div>
</div>

<!-- banner -->
<section class="pro_banner1">
    <h1>PRODUCT DETAILS</h1>
</section>


<!-- product details -->
<section class="product-detail-section">

<div class="product-image-box">

    <img
    src="/uploads/<%= product.main_image %>"
    class="main-image"
    alt="<%= product.product_name %>">

    <div class="image-info">
        <%= product.short_description %>
    </div>

</div>

<div class="divider"></div>

<div class="product-info">

    <h2>
        <%= product.product_name %>
    </h2>

    <div class="stars">
        ★★★★★
    </div>

    <% if(product.feature1){ %>
    <div class="feature">
        <span class="check-box">✓</span>
        <%= product.feature1 %>
    </div>
    <% } %>

    <% if(product.feature2){ %>
    <div class="feature">
        <span class="check-box">✓</span>
        <%= product.feature2 %>
    </div>
    <% } %>

    <% if(product.feature3){ %>
    <div class="feature">
        <span class="check-box">✓</span>
        <%= product.feature3 %>
    </div>
    <% } %>

    <% if(product.feature4){ %>
    <div class="feature">
        <span class="check-box">✓</span>
        <%= product.feature4 %>
    </div>
    <% } %>

    <div style="margin-top:25px;">

        <h4>Description</h4>

        <p>
            <%= product.description %>
        </p>

    </div>

    <div class="share-box">

        <span>Share Now</span>

        <a href="#" target="_blank" class="social-icon">
            <i class="fab fa-facebook-f"></i>
        </a>

        <a href="#" target="_blank" class="social-icon">
            <i class="fab fa-linkedin-in"></i>
        </a>

        <a href="#" target="_blank" class="social-icon">
            <i class="fab fa-instagram"></i>
        </a>

        <a href="#" target="_blank" class="social-icon">
            <i class="fab fa-whatsapp"></i>
        </a>

    </div>

   <button class="know-more-btn"
        onclick="openInquiry('<%= product.product_name %>')">
    Inquiry
</button>

</div>


</section>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">


<!-- Frequently Asked Questions -->
<section class="faq-section">

    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">

        <button class="faq-question">
            1. What are Sawdust Briquettes?
            <span class="icon">+</span>
        </button>

        <div class="faq-answer">
            Sawdust briquettes are compressed biomass fuel blocks made from sawdust and other agricultural waste materials. They are an eco-friendly alternative to coal and firewood.
        </div>

    </div>

    <div class="faq-item">

        <button class="faq-question">
            2. What are the main uses of Sawdust Briquettes?
            <span class="icon">+</span>
        </button>

        <div class="faq-answer">
            They are widely used in boilers, furnaces, textile industries, food processing units, power plants, and manufacturing industries.
        </div>

    </div>

    <div class="faq-item">

        <button class="faq-question">
            3. What is the calorific value of Sawdust Briquettes?
            <span class="icon">+</span>
        </button>

        <div class="faq-answer">
            Typically, the calorific value ranges between 3,800 and 4,500 Kcal/kg, depending on the raw material and manufacturing process.
        </div>

    </div>

    <div class="faq-item">

        <button class="faq-question">
            4. Are Sawdust Briquettes environmentally friendly?
            <span class="icon">+</span>
        </button>

        <div class="faq-answer">
            Yes. They are made from renewable biomass waste and produce lower carbon emissions compared to fossil fuels.
        </div>

    </div>

</section>
